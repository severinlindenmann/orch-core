              ]
            },
            {
              "type": "progress",
              "label": "Budget used (CHF)",
              "value": {
                "$ref": "addon.monthChf"
              },
              "max": {
                "$ref": "addon.budgetChf"
              }
            },
            {
              "type": "chart",
              "kind": "line",
              "xKey": "day",
              "series": [
                {
                  "key": "chf",
                  "label": "CHF per day"
                }
              ],
              "points": {
                "$ref": "addon.perDay"
              }
            },
            {
              "type": "chart",
              "kind": "bar",
              "xKey": "model",
              "series": [
                {
                  "key": "chf",
                  "label": "CHF per model"
                }
              ],
              "points": {
                "$ref": "addon.perModel"
              }
            },
            {
              "type": "table",
              "columns": [
                {
                  "key": "ticket",
                  "label": "Ticket"
                },
                {
                  "key": "sessions",
                  "label": "Sessions"
                },
                {
                  "key": "time",
                  "label": "Time"
                },
                {
                  "key": "cost",
                  "label": "Cost"
                }
              ],
              "rows": {
                "$ref": "addon.topTickets"
              }
            }
          ]
        }
      },
      {
        "slot": "today.card",
        "id": "week",
        "title": "Agent spend",
        "icon": "Gauge",
        "node": {
          "type": "stat",
          "label": "This week",
          "value": "${addon.weekCents|chf}",
          "hint": "${addon.monthCents|chf} this month"
        }
      },
      {
        "slot": "ticket.panel",
        "id": "ticket",
        "title": "Usage",
        "icon": "Gauge",
        "when": "addon.byTicket.$ticket",
        "node": {
          "type": "kv",
          "pairs": [
            {
              "label": "Cost",
              "value": "${addon.byTicket.$ticket.cents|chf}"
            },
            {
              "label": "Tokens",
              "value": "${addon.byTicket.$ticket.tokens|ktok}"
            },
            {
              "label": "Sessions",
              "value": {
                "$ref": "addon.byTicket.$ticket.sessions"
              }
            },
            {
              "label": "Agent time",
              "value": "${addon.byTicket.$ticket.ms|duration}"
            }
          ]
        }
      },
      {
        "slot": "settings",
        "id": "usage.settings",
        "title": "Usage",
        "icon": "Gauge",
        "node": {
          "type": "form",
          "schema": {
            "type": "object",
            "properties": {
              "budget_chf": {
                "type": "number",
                "title": "Monthly budget (CHF)"
              }
            }
          },
          "formData": {
            "$ref": "addon.settings"
          },
          "action": "save_settings",
          "submitLabel": "Save"
        }
      }
    ],
    "actions": { "save_settings": { "minRole": "owner" } },
    "package_sha256": "cee112f07556821db82c7e88c0557e3a55b686921e33baef1ac29eec1c3ad78e",
    "update": null
  },
