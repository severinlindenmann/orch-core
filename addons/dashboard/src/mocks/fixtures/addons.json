[
  {
    "name": "publish",
    "title": "Publish",
    "version": "0.3.0",
    "description": "Share a read-only view of a ticket or artifact through a signed link.",
    "capabilities": [
      "serve_http",
      "network"
    ],
    "first_party": true,
    "contributions": [
      {
        "slot": "nav",
        "id": "shares",
        "title": "Apps & shares",
        "icon": "Share2",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "stack",
              "direction": "row",
              "children": [
                {
                  "type": "stat",
                  "label": "Live shares",
                  "value": {
                    "$ref": "addon.liveShares"
                  },
                  "hint": "read-only links"
                },
                {
                  "type": "stat",
                  "label": "Views",
                  "value": {
                    "$ref": "addon.views"
                  },
                  "hint": "all shares"
                },
                {
                  "type": "stat",
                  "label": "Apps running",
                  "value": {
                    "$ref": "addon.runningCount"
                  },
                  "hint": "of ${addon.appCount}"
                }
              ]
            },
            {
              "type": "markdown",
              "text": "### Apps\nSmall apps served from a workspace folder under `${addon.settings.namespace}`."
            },
            {
              "type": "table",
              "columns": [
                {
                  "key": "name",
                  "label": "App"
                },
                {
                  "key": "kind",
                  "label": "Type"
                },
                {
                  "key": "status",
                  "label": "State"
                },
                {
                  "key": "recipients",
                  "label": "Recipients"
                },
                {
                  "key": "folder",
                  "label": "Folder"
                }
              ],
              "rows": {
                "$ref": "addon.appRows"
              },
              "rowActions": [
                {
                  "label": "Start",
                  "action": "start",
                  "args": {
                    "id": "$row.id"
                  },
                  "variant": "ghost",
                  "when": "$row.canStart"
                },
                {
                  "label": "Stop",
                  "action": "stop",
                  "args": {
                    "id": "$row.id"
                  },
                  "variant": "ghost",
                  "when": "$row.canStop"
                },
                {
                  "label": "Logs",
                  "action": "logs",
                  "args": {
                    "id": "$row.id"
                  },
                  "variant": "ghost"
                }
              ]
            },
            {
              "type": "markdown",
              "text": "### Needs attention\nFailed builds. Redeploy rebuilds from the folder; the decision on Today can roll back to the last good version."
            },
            {
              "type": "list",
              "items": {
                "$ref": "addon.attention"
              },
              "empty": "No failed builds."
            },
            {
              "type": "code",
              "language": "text",
              "text": "${addon.failedLog}"
            },
            {
              "type": "markdown",
              "text": "### Shares\nRead-only links with an expiry. A show-once link is displayed a single time and cannot be copied again."
            },
            {
              "type": "list",
              "items": {
                "$ref": "addon.shareItems"
              },
              "empty": "No shares yet."
            },
            {
              "type": "button",
              "label": "New show-once link",
              "action": "share_once",
              "variant": "secondary"
            }
          ]
        }
      },
      {
        "slot": "today.card",
        "id": "shares.today",
        "title": "Apps & shares",
        "icon": "Share2",
        "node": {
          "type": "stat",
          "label": "Apps",
          "value": "${addon.summary}",
          "hint": "${addon.liveShares} live shares · ${addon.views} views"
        }
      },
      {
        "slot": "ticket.panel",
        "id": "shares.ticket",
        "title": "Shares",
        "icon": "Share2",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "list",
              "items": {
                "$ref": "addon.sharesByTicket.$ticket"
              },
              "empty": "Not shared yet."
            },
            {
              "type": "button",
              "label": "Share report…",
              "action": "share",
              "variant": "secondary"
            }
          ]
        }
      },
      {
        "slot": "settings",
        "id": "publish.settings",
        "title": "Publish",
        "icon": "Share2",
        "node": {
          "type": "form",
          "schema": {
            "type": "object",
            "properties": {
              "default_expiry_days": {
                "type": "integer",
                "title": "Link expiry (days)"
              },
              "allow_artifacts": {
                "type": "boolean",
                "title": "Include artifacts"
              },
              "namespace": {
                "type": "string",
                "title": "Namespace (link host p.<namespace>.example)"
              }
            }
          },
          "formData": {
            "$ref": "addon.settings"
          },
          "action": "save_settings",
          "submitLabel": "Save"
        }
      }
    ],
    "decisions": [
      {
        "kind": "decision",
        "id": "dec_publish_report",
        "addon": "publish",
        "ticket": "DEMO-0041",
        "title": "Publish report",
        "question": "Publish Before/after report as secret link for 7 days?",
        "detail": "The link is read-only and unlisted. 3 screenshots and the reconciliation table are included.",
        "options": [
          {
            "key": "yes",
            "label": "Publish",
            "primary": true
          },
          {
            "key": "no",
            "label": "Not now"
          }
        ],
        "action": "decide"
      },
      {
        "kind": "decision",
        "id": "dec_publish_failed_build",
        "addon": "publish",
        "title": "Retry failed build",
        "question": "Ops notebook failed to build: retry with the last good version?",
        "detail": "The last build failed on a missing module (meter_utils). The last good version is from 2 days ago; retrying rebuilds the notebook from it and keeps the newer files.",
        "options": [
          {
            "key": "retry",
            "label": "Retry last good version",
            "primary": true
          },
          {
            "key": "no",
            "label": "Leave it"
          }
        ],
        "action": "decide"
      }
    ],
    "commands": [
      {
        "id": "share",
        "title": "Share current ticket",
        "action": "share"
      },
      {
        "id": "share_once",
        "title": "Create a show-once link",
        "action": "share_once"
      }
    ],
    "actions": { "save_settings": { "minRole": "owner" }, "decide": { "minRole": "maintainer", "decision": true }, "logs": { "minRole": "viewer", "label": "Show app logs" }, "stop": { "minRole": "member", "undo": "start" }, "revoke": { "minRole": "member", "confirm": "destructive", "confirmLabel": "Revoke link", "confirmText": "The link stops working for everyone who has it. This cannot be undone." } },
    "package_sha256": "5bff517d9651da29e7bb20407bede9b158b27f279f9e828b1854749b364b8919",
    "update": null
  },
  {
    "name": "github",
    "title": "GitHub",
    "version": "0.5.2",
    "description": "Links branches and pull requests to tickets and shows their check status.",
    "capabilities": [
      "network"
    ],
    "first_party": true,
    "contributions": [
      {
        "slot": "nav",
        "id": "reviews",
        "title": "Code reviews",
        "icon": "GitPullRequest",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "stack",
              "direction": "row",
              "children": [
                {
                  "type": "stat",
                  "label": "Open PRs",
                  "value": "${addon.openPrs}"
                },
                {
                  "type": "stat",
                  "label": "Need review",
                  "value": "${addon.needReview}"
                },
                {
                  "type": "stat",
                  "label": "Checks failing",
                  "value": "${addon.checksFailing}"
                }
              ]
            },
            {
              "type": "table",
              "columns": [
                {
                  "key": "repo",
                  "label": "Repository"
                },
                {
                  "key": "pr",
                  "label": "PR"
                },
                {
                  "key": "title",
                  "label": "Title"
                },
                {
                  "key": "ticket",
                  "label": "Ticket"
                },
                {
                  "key": "checks",
                  "label": "Checks"
                },
                {
                  "key": "review",
                  "label": "Review"
                },
                {
                  "key": "updated",
                  "label": "Updated"
                }
              ],
              "rows": {
                "$ref": "addon.prRows"
              },
              "empty": "No open pull requests.",
              "rowActions": [
                {
                  "label": "Approve on GitHub",
                  "action": "approve",
                  "args": {
                    "id": "$row.id"
                  },
                  "variant": "secondary"
                },
                {
                  "label": "Open",
                  "action": "open",
                  "args": {
                    "id": "$row.id"
                  },
                  "variant": "ghost"
                }
              ]
            },
            {
              "type": "button",
              "label": "Refresh from GitHub",
              "action": "refresh",
              "variant": "secondary"
            }
          ]
        }
      },
      {
        "slot": "today.card",
        "id": "reviews.today",
        "title": "PRs needing review",
        "icon": "GitPullRequest",
        "node": {
          "type": "list",
          "items": {
            "$ref": "addon.todayItems"
          },
          "empty": "No pull requests need a review."
        }
      },
      {
        "slot": "board.lane",
        "id": "issues",
        "title": "External \u00b7 GitHub issues",
        "icon": "Github",
        "node": {
          "type": "list",
          "items": {
            "$ref": "addon.issueItems"
          },
          "empty": "No open issues."
        }
      },
      {
        "slot": "ticket.panel",
        "id": "pr",
        "title": "Pull request",
        "icon": "GitPullRequest",
        "when": "addon.prByTicket.$ticket",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "kv",
              "pairs": [
                {
                  "label": "Repository",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.repo"
                  },
                  "mono": true
                },
                {
                  "label": "Branch",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.branch"
                  },
                  "mono": true
                },
                {
                  "label": "PR",
                  "value": "#${addon.prByTicket.$ticket.number}"
                },
                {
                  "label": "Author",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.author"
                  }
                },
                {
                  "label": "Diff",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.diff"
                  }
                },
                {
                  "label": "Review",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.review"
                  }
                }
              ]
            },
            {
              "type": "kv",
              "pairs": {
                "$ref": "addon.prByTicket.$ticket.checkPairs"
              }
            },
            {
              "type": "link",
              "label": "Open on GitHub",
              "href": "${addon.prByTicket.$ticket.url}"
            },
            {
              "type": "button",
              "label": "Refresh",
              "action": "refresh",
              "variant": "secondary"
            }
          ]
        }
      },
      {
        "slot": "settings",
        "id": "github.settings",
        "title": "GitHub",
        "icon": "Github",
        "node": {
          "type": "form",
          "schema": {
            "type": "object",
            "properties": {
              "org": {
                "type": "string",
                "title": "Organisation"
              },
              "repos": {
                "type": "string",
                "title": "Repositories (comma separated)"
              },
              "poll_minutes": {
                "type": "integer",
                "title": "Poll interval (minutes)",
                "enum": [
                  1,
                  5,
                  15,
                  30
                ]
              },
              "link_prs": {
                "type": "boolean",
                "title": "Link PRs from branch names"
              }
            }
          },
          "formData": {
            "$ref": "addon.settings"
          },
          "action": "save_settings",
          "submitLabel": "Save"
        }
      }
    ],
    "commands": [
      {
        "id": "refresh",
        "title": "Refresh pull requests",
        "action": "refresh"
      }
    ],
    "actions": { "save_settings": { "minRole": "owner" }, "open": { "minRole": "viewer", "kind": "navigation", "label": "Open pull request" } },
    "package_sha256": "0f33d256eae57ec0f00baba48552b229d04f5fb2bfe277ce02667cf7196f6fa9",
    "update": {
      "version": "0.6.0",
      "capabilities": [
        "network",
        "spawn_agent"
      ],
      "package_sha256": "59332aa879d44085369f04919255e071d27e293b4c2d5f000fcd478e507684ee",
      "changelog": "Review requests can now start an agent session that opens a fix branch. Adds the spawn_agent capability."
    }
  },
  {
    "name": "usage",
    "title": "Usage",
    "version": "0.2.1",
    "description": "Tracks agent time and cost per ticket. Money is stored in cents.",
    "capabilities": [],
    "first_party": true,
    "contributions": [
      {
        "slot": "nav",
        "id": "overview",
        "title": "Usage",
        "icon": "Gauge",
        "node": {
          "type": "stack",
          "children": [
            {
              "$ref": "addon.budgetNotice"
            },
            {
              "type": "stack",
              "direction": "row",
              "children": [
                {
                  "type": "stat",
                  "label": "This week",
                  "value": "${addon.weekCents|chf}",
                  "hint": "last 7 days"
                },
                {
                  "type": "stat",
                  "label": "Month to date",
                  "value": "${addon.monthCents|chf}",
                  "hint": "${addon.budgetPct}% of CHF ${addon.budgetChf} budget"
                },
                {
                  "type": "stat",
                  "label": "Tokens",
                  "value": "${addon.tokens30|ktok}",
                  "hint": "last 30 days, in + out"
