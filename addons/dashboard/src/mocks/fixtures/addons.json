[
  {
    "name": "publish",
    "title": "Publish",
    "version": "0.3.0",
    "description": "Share a read-only view of a ticket or artifact through a signed link.",
    "capabilities": [
      "serve_http",
      "network"
    ],
    "first_party": true,
    "contributions": [
      {
        "slot": "nav",
        "id": "shares",
        "title": "Apps & shares",
        "icon": "Share2",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "stack",
              "direction": "row",
              "fit": true,
              "children": [
                { "type": "markdown", "text": "Live apps, and read-only links to tickets and artifacts. Files you send go through Drop." },
                { "type": "link", "label": "Open Drop", "href": "/addon/drop/drop" }
              ]
            },
            {
              "type": "stack",
              "direction": "row",
              "children": [
                {
                  "type": "stat",
                  "label": "Live shares",
                  "value": {
                    "$ref": "addon.liveShares"
                  },
                  "hint": "read-only links"
                },
                {
                  "type": "stat",
                  "label": "Views",
                  "value": {
                    "$ref": "addon.views"
                  },
                  "hint": "all shares"
                },
                {
                  "type": "stat",
                  "label": "Apps running",
                  "value": {
                    "$ref": "addon.runningCount"
                  },
                  "hint": "of ${addon.appCount}"
                }
              ]
            },
            {
              "$ref": "addon.attentionNode"
            },
            {
              "type": "tabs",
              "id": "publish",
              "tabs": [
                {
                  "id": "apps",
                  "label": "Apps",
                  "count": {
                    "$ref": "addon.appCount"
                  },
                  "node": {
                    "type": "stack",
                    "children": [
                      {
                        "type": "table",
                        "columns": [
                          {
                            "key": "name",
                            "label": "App"
                          },
                          {
                            "key": "kind",
                            "label": "Type"
                          },
                          {
                            "key": "status",
                            "label": "State",
                            "cell": "state"
                          },
                          {
                            "key": "note",
                            "label": "Note"
                          },
                          {
                            "key": "recipients",
                            "label": "Recipients"
                          },
                          {
                            "key": "folder",
                            "label": "Folder"
                          }
                        ],
                        "rows": {
                          "$ref": "addon.appRows"
                        },
                        "empty": "No apps yet. Put a small app in a workspace folder and it appears here.",
                        "rowActions": [
                          {
                            "label": "Start",
                            "action": "start",
                            "args": {
                              "id": "$row.id"
                            },
                            "variant": "ghost",
                            "when": "$row.canStart"
                          },
                          {
                            "label": "Stop",
                            "action": "stop",
                            "args": {
                              "id": "$row.id"
                            },
                            "variant": "ghost",
                            "when": "$row.canStop",
                            "pendingLabel": "Stopping…"
                          },
                          {
                            "label": "Logs",
                            "action": "logs",
                            "args": {
                              "id": "$row.id"
                            },
                            "variant": "ghost"
                          }
                        ]
                      }
                    ]
                  }
                },
                {
                  "id": "shares",
                  "label": "Shares",
                  "count": {
                    "$ref": "addon.liveShares"
                  },
                  "node": {
                    "type": "stack",
                    "children": [
                      {
                        "type": "table",
                        "columns": [
                          {
                            "key": "title",
                            "label": "Share"
                          },
                          {
                            "key": "kind",
                            "label": "Kind"
                          },
                          {
                            "key": "ticket",
                            "label": "Ticket"
                          },
                          {
                            "key": "expires",
                            "label": "Expires in"
                          },
                          {
                            "key": "views",
                            "label": "Views"
                          },
                          {
                            "key": "last",
                            "label": "Last viewed"
                          }
                        ],
                        "rows": {
                          "$ref": "addon.shareRows"
                        },
                        "empty": "No shares yet. Share a report from a ticket, or make a one-time link below.",
                        "rowActions": [
                          {
                            "label": "Copy link",
                            "action": "copy_link",
                            "args": {
                              "id": "$row.id"
                            },
                            "variant": "ghost",
                            "when": "$row.canCopy"
                          },
                          {
                            "label": "Shown once",
                            "action": "copy_link",
                            "args": {
                              "id": "$row.id"
                            },
                            "variant": "ghost",
                            "when": "$row.shownOnce"
                          },
                          {
                            "label": "Extend 7 days",
                            "action": "extend",
                            "args": {
                              "id": "$row.id"
                            },
                            "variant": "ghost"
                          },
                          {
                            "label": "Revoke",
                            "action": "revoke",
                            "args": {
                              "id": "$row.id"
                            },
                            "variant": "danger"
                          }
                        ]
                      },
                      {
                        "type": "button",
                        "label": "New show-once link",
                        "action": "share_once",
                        "variant": "secondary"
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "slot": "today.card",
        "id": "shares.today",
        "title": "Apps & shares",
        "icon": "Share2",
        "node": {
          "type": "stat",
          "label": "Apps",
          "value": "${addon.summary}",
          "hint": "${addon.liveShares} live shares · ${addon.views} views"
        }
      },
      {
        "slot": "ticket.panel",
        "id": "shares.ticket",
        "title": "Shares",
        "icon": "Share2",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "list",
              "items": {
                "$ref": "addon.sharesByTicket.$ticket"
              },
              "empty": "Not shared yet."
            },
            {
              "type": "button",
              "label": "Share report…",
              "action": "share",
              "variant": "secondary"
            }
          ]
        }
      },
      {
        "slot": "settings",
        "id": "publish.settings",
        "title": "Publish",
        "icon": "Share2",
        "node": {
          "type": "form",
          "schema": {
            "type": "object",
            "properties": {
              "default_expiry_days": {
                "type": "integer",
                "title": "Link expiry (days)"
              },
              "allow_artifacts": {
                "type": "boolean",
                "title": "Include artifacts"
              },
              "namespace": {
                "type": "string",
                "title": "Namespace (link host p.<namespace>.example)"
              }
            }
          },
          "formData": {
            "$ref": "addon.settings"
          },
          "action": "save_settings",
          "submitLabel": "Save"
        }
      }
    ],
    "decisions": [
      {
        "kind": "decision",
        "id": "dec_publish_report",
        "addon": "publish",
        "ticket": "DEMO-0041",
        "title": "Publish report",
        "question": "Publish Before/after report as secret link for 7 days?",
        "detail": "The link is read-only and unlisted. 3 screenshots and the reconciliation table are included.",
        "options": [
          {
            "key": "yes",
            "label": "Publish",
            "primary": true
          },
          {
            "key": "no",
            "label": "Not now"
          }
        ],
        "action": "decide"
      },
      {
        "kind": "decision",
        "id": "dec_publish_failed_build",
        "addon": "publish",
        "title": "Retry failed build",
        "question": "Ops notebook failed to build: retry with the last good version?",
        "detail": "The last build failed on a missing module (meter_utils). The last good version is from 2 days ago; retrying rebuilds the notebook from it and keeps the newer files.",
        "options": [
          {
            "key": "retry",
            "label": "Retry last good version",
            "primary": true
          },
          {
            "key": "no",
            "label": "Leave it"
          }
        ],
        "action": "decide"
      }
    ],
    "commands": [
      {
        "id": "share",
        "title": "Share current ticket",
        "action": "share"
      },
      {
        "id": "share_once",
        "title": "Create a show-once link",
        "action": "share_once"
      }
    ],
    "actions": { "save_settings": { "minRole": "owner" }, "decide": { "minRole": "maintainer", "decision": true }, "logs": { "minRole": "viewer", "label": "Show app logs" }, "stop": { "minRole": "member", "undo": "start", "confirm": "destructive", "confirmLabel": "Stop app", "confirmText": "Anyone using the app loses it until you start it again. You can undo this right after." }, "share_once": { "minRole": "member", "label": "Create show-once link", "confirm": "options", "options": { "note": "The link is shown once and cannot be copied again.", "fields": [ { "key": "what", "label": "What to share", "default": "ticket", "choices": [ { "value": "ticket", "label": "The ticket page (read-only)" }, { "value": "report", "label": "The before/after report" } ] }, { "key": "expires_days", "label": "Works for", "default": 7, "choices": [ { "value": 1, "label": "1 day" }, { "value": 3, "label": "3 days" }, { "value": 7, "label": "7 days" }, { "value": 30, "label": "30 days" } ] }, { "key": "view_limit", "label": "Opens", "default": 1, "choices": [ { "value": 1, "label": "Once" }, { "value": 3, "label": "At most 3 times" }, { "value": 10, "label": "At most 10 times" }, { "value": 0, "label": "No limit" } ] } ] } }, "revoke": { "minRole": "member", "confirm": "destructive", "confirmLabel": "Revoke link", "confirmText": "The link stops working for everyone who has it. This cannot be undone." } },
    "package_sha256": "5bff517d9651da29e7bb20407bede9b158b27f279f9e828b1854749b364b8919",
    "update": null
  },
  {
    "name": "github",
    "title": "GitHub",
    "version": "0.5.2",
    "description": "Links branches and pull requests to tickets and shows their check status.",
    "capabilities": [
      "network"
    ],
    "first_party": true,
    "contributions": [
      {
        "slot": "nav",
        "id": "reviews",
        "title": "Code reviews",
        "icon": "GitPullRequest",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "stack",
              "direction": "row",
              "children": [
                {
                  "type": "stat",
                  "label": "Open PRs",
                  "value": "${addon.openPrs}"
                },
                {
                  "type": "stat",
