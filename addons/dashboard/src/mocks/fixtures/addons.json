[
  {
    "name": "publish",
    "title": "Publish",
    "version": "0.3.0",
    "description": "Share a read-only view of a ticket or artifact through a signed link.",
    "capabilities": [
      "serve_http",
      "network"
    ],
    "first_party": true,
    "contributions": [
      {
        "slot": "nav",
        "id": "shares",
        "title": "Apps & shares",
        "icon": "Share2",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "stack",
              "direction": "row",
              "children": [
                {
                  "type": "stat",
                  "label": "Live shares",
                  "value": {
                    "$ref": "addon.liveShares"
                  },
                  "hint": "read-only links"
                },
                {
                  "type": "stat",
                  "label": "Views",
                  "value": {
                    "$ref": "addon.views"
                  },
                  "hint": "all shares"
                },
                {
                  "type": "stat",
                  "label": "Apps running",
                  "value": {
                    "$ref": "addon.runningCount"
                  },
                  "hint": "of ${addon.appCount}"
                }
              ]
            },
            {
              "type": "markdown",
              "text": "### Apps\nSmall apps served from a workspace folder under `${addon.settings.namespace}`."
            },
            {
              "type": "table",
              "columns": [
                {
                  "key": "name",
                  "label": "App"
                },
                {
                  "key": "kind",
                  "label": "Type"
                },
                {
                  "key": "status",
                  "label": "State"
                },
                {
                  "key": "recipients",
                  "label": "Recipients"
                },
                {
                  "key": "folder",
                  "label": "Folder"
                }
              ],
              "rows": {
                "$ref": "addon.appRows"
              },
              "rowActions": [
                {
                  "label": "Start",
                  "action": "start",
                  "args": {
                    "id": "$row.id"
                  },
                  "variant": "ghost"
                },
                {
                  "label": "Stop",
                  "action": "stop",
                  "args": {
                    "id": "$row.id"
                  },
                  "variant": "ghost"
                },
                {
                  "label": "Logs",
                  "action": "logs",
                  "args": {
                    "id": "$row.id"
                  },
                  "variant": "ghost"
                }
              ]
            },
            {
              "type": "markdown",
              "text": "### Needs attention\nFailed builds. Redeploy rebuilds from the folder; the decision on Today can roll back to the last good version."
            },
            {
              "type": "list",
              "items": {
                "$ref": "addon.attention"
              },
              "empty": "No failed builds."
            },
            {
              "type": "code",
              "language": "text",
              "text": "${addon.failedLog}"
            },
            {
              "type": "markdown",
              "text": "### Shares\nRead-only links with an expiry. A show-once link is displayed a single time and cannot be copied again."
            },
            {
              "type": "list",
              "items": {
                "$ref": "addon.shareItems"
              },
              "empty": "No shares yet."
            },
            {
              "type": "button",
              "label": "New show-once link",
              "action": "share_once",
              "variant": "secondary"
            }
          ]
        }
      },
      {
        "slot": "today.card",
        "id": "shares.today",
        "title": "Apps & shares",
        "icon": "Share2",
        "node": {
          "type": "stat",
          "label": "Apps",
          "value": "${addon.summary}",
          "hint": "${addon.liveShares} live shares · ${addon.views} views"
        }
      },
      {
        "slot": "ticket.panel",
        "id": "shares.ticket",
        "title": "Shares",
        "icon": "Share2",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "list",
              "items": {
                "$ref": "addon.sharesByTicket.$ticket"
              },
              "empty": "Not shared yet."
            },
            {
              "type": "button",
              "label": "Share report…",
              "action": "share",
              "variant": "secondary"
            }
          ]
        }
      },
      {
        "slot": "settings",
        "id": "publish.settings",
        "title": "Publish",
        "icon": "Share2",
        "node": {
          "type": "form",
          "schema": {
            "type": "object",
            "properties": {
              "default_expiry_days": {
                "type": "integer",
                "title": "Link expiry (days)"
              },
              "allow_artifacts": {
                "type": "boolean",
                "title": "Include artifacts"
              },
              "namespace": {
                "type": "string",
                "title": "Namespace (link host p.<namespace>.example)"
              }
            }
          },
          "formData": {
            "$ref": "addon.settings"
          },
          "action": "save_settings",
          "submitLabel": "Save"
        }
      }
    ],
    "decisions": [
      {
        "kind": "decision",
        "id": "dec_publish_report",
        "addon": "publish",
        "ticket": "DEMO-0041",
        "title": "Publish report",
        "question": "Publish Before/after report as secret link for 7 days?",
        "detail": "The link is read-only and unlisted. 3 screenshots and the reconciliation table are included.",
        "options": [
          {
            "key": "yes",
            "label": "Publish",
            "primary": true
          },
          {
            "key": "no",
            "label": "Not now"
          }
        ],
        "action": "decide"
      },
      {
        "kind": "decision",
        "id": "dec_publish_failed_build",
        "addon": "publish",
        "title": "Retry failed build",
        "question": "Ops notebook failed to build: retry with the last good version?",
        "detail": "The last build failed on a missing module (meter_utils). The last good version is from 2 days ago; retrying rebuilds the notebook from it and keeps the newer files.",
        "options": [
          {
            "key": "retry",
            "label": "Retry last good version",
            "primary": true
          },
          {
            "key": "no",
            "label": "Leave it"
          }
        ],
        "action": "decide"
      }
    ],
    "commands": [
      {
        "id": "share",
        "title": "Share current ticket",
        "action": "share"
      },
      {
        "id": "share_once",
        "title": "Create a show-once link",
        "action": "share_once"
      }
    ],
    "package_sha256": "5bff517d9651da29e7bb20407bede9b158b27f279f9e828b1854749b364b8919",
    "update": null
  },
