      },
      {
        "slot": "today.card",
        "id": "reviews.today",
        "title": "PRs needing review",
        "icon": "GitPullRequest",
        "node": {
          "type": "list",
          "items": {
            "$ref": "addon.todayItems"
          },
          "empty": "No pull requests need a review."
        }
      },
      {
        "slot": "board.lane",
        "id": "issues",
        "title": "External \u00b7 GitHub issues",
        "icon": "Github",
        "node": {
          "type": "list",
          "items": {
            "$ref": "addon.issueItems"
          },
          "empty": "No open issues."
        }
      },
      {
        "slot": "ticket.panel",
        "id": "pr",
        "title": "Pull request",
        "icon": "GitPullRequest",
        "when": "addon.prByTicket.$ticket",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "kv",
              "pairs": [
                {
                  "label": "Repository",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.repo"
                  },
                  "mono": true
                },
                {
                  "label": "Branch",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.branch"
                  },
                  "mono": true
                },
                {
                  "label": "PR",
                  "value": "#${addon.prByTicket.$ticket.number}"
                },
                {
                  "label": "Author",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.author"
                  }
                },
                {
                  "label": "Diff",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.diff"
                  }
                },
                {
                  "label": "Review",
                  "value": {
                    "$ref": "addon.prByTicket.$ticket.review"
                  }
                }
              ]
            },
            {
              "type": "kv",
              "pairs": {
                "$ref": "addon.prByTicket.$ticket.checkPairs"
              }
            },
            {
              "type": "link",
              "label": "Open on GitHub",
              "href": "${addon.prByTicket.$ticket.url}"
            },
            {
              "type": "button",
              "label": "Refresh",
              "action": "refresh",
              "variant": "secondary"
            }
          ]
        }
      },
      {
        "slot": "settings",
        "id": "github.settings",
        "title": "GitHub",
        "icon": "Github",
        "node": {
          "type": "form",
          "schema": {
            "type": "object",
            "properties": {
              "org": {
                "type": "string",
                "title": "Organisation"
              },
              "repos": {
                "type": "string",
                "title": "Repositories (comma separated)"
              },
              "poll_minutes": {
                "type": "integer",
                "title": "Poll interval (minutes)",
                "enum": [
                  1,
                  5,
                  15,
                  30
                ]
              },
              "link_prs": {
                "type": "boolean",
                "title": "Link PRs from branch names"
              }
            }
          },
          "formData": {
            "$ref": "addon.settings"
          },
          "action": "save_settings",
          "submitLabel": "Save"
        }
      }
    ],
    "commands": [
      {
        "id": "refresh",
        "title": "Refresh pull requests",
        "action": "refresh"
      }
    ],
    "actions": { "save_settings": { "minRole": "owner" }, "open": { "minRole": "viewer", "kind": "navigation", "label": "Open pull request" } },
    "package_sha256": "0f33d256eae57ec0f00baba48552b229d04f5fb2bfe277ce02667cf7196f6fa9",
    "update": {
      "version": "0.6.0",
      "capabilities": [
        "network",
        "spawn_agent"
      ],
      "package_sha256": "59332aa879d44085369f04919255e071d27e293b4c2d5f000fcd478e507684ee",
      "changelog": "Review requests can now start an agent session that opens a fix branch. Adds the spawn_agent capability."
    }
  },
  {
    "name": "usage",
    "title": "Usage",
    "version": "0.2.1",
    "description": "Tracks agent time and cost per ticket. Money is stored in cents.",
    "capabilities": [],
    "first_party": true,
    "contributions": [
      {
        "slot": "nav",
        "id": "overview",
        "title": "Usage",
        "icon": "Gauge",
        "node": {
          "type": "stack",
          "children": [
