          "children": [{ "$ref": "addon.byTicket.$ticket.run" }, { "$ref": "addon.byTicket.$ticket.setup" }]
        }
      },
      {
        "slot": "nav",
        "id": "start",
        "title": "Start agent",
        "icon": "Bot",
        "node": {
          "type": "stack",
          "children": [
            { "type": "markdown", "text": "Start an agent session on a ticket. orch confirms every start in its own dialog and runs it under your grant; revoking the grant stops it." },
            {
              "type": "form",
              "schema": {
                "type": "object",
                "required": ["ticket"],
                "properties": {
                  "ticket": { "type": "string", "title": "Ticket", "oneOf": { "$ref": "addon.ticketOptions" } },
                  "mode": { "type": "string", "title": "Mode", "default": "work", "oneOf": [{ "const": "refine", "title": "Refine" }, { "const": "work", "title": "Work on ticket" }, { "const": "fix", "title": "Fix failing checks" }, { "const": "continue", "title": "Continue after feedback" }] },
                  "harness": { "type": "string", "title": "Harness", "default": "claude-code", "oneOf": [{ "const": "claude-code", "title": "Claude Code" }, { "const": "codex", "title": "Codex" }] },
                  "where": { "type": "string", "title": "Where", "default": "background", "oneOf": [{ "const": "terminals", "title": "Terminals" }, { "const": "background", "title": "Background" }] }
                }
              },
              "formData": { "$ref": "addon.page.form" },
              "action": "configure",
              "submitLabel": "Preview command"
            },
            { "$ref": "addon.page.preview" },
            { "type": "markdown", "text": "## Running" },
            {
              "type": "table",
              "columns": [{ "key": "ticket", "label": "Ticket" }, { "key": "title", "label": "Title" }, { "key": "harness", "label": "Harness" }, { "key": "model", "label": "Model" }, { "key": "state", "label": "State" }, { "key": "started", "label": "Started" }],
              "rows": { "$ref": "addon.runs" },
              "empty": "Nothing is running.",
              "rowActions": [{ "label": "Stop", "action": "stop", "args": { "session": "$row.session" }, "variant": "danger" }]
