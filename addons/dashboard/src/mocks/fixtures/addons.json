  {
    "name": "estimate",
    "title": "Estimate",
    "version": "0.2.0",
    "description": "Story points on tickets, rolled up on epics.",
    "capabilities": [],
    "first_party": true,
    "contributions": [
      {
        "slot": "ticket.panel",
        "id": "points",
        "title": "Estimate",
        "icon": "Ruler",
        "node": {
          "type": "form",
          "schema": { "$ref": "addon.pointsSchema" },
          "uiSchema": {
            "points": {
              "ui:placeholder": "Choose"
            }
          },
          "formData": {
            "$ref": "ticket.addons.estimate"
          },
          "action": "set",
          "submitLabel": "Save estimate"
        }
      },
      {
        "slot": "board.card_field",
        "id": "points",
        "title": "Points",
        "icon": "Ruler",
        "node": {
          "type": "stat",
          "label": "pt",
          "value": {
            "$ref": "ticket.addons.estimate.points"
