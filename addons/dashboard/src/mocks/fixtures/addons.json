                  "count": {
                    "$ref": "addon.openPrs"
                  },
                  "node": {
                    "type": "stack",
                    "children": [
                      {
                        "type": "table",
                        "columns": [
                          {
                            "key": "repo",
                            "label": "Repository"
                          },
                          {
                            "key": "pr",
                            "label": "PR"
                          },
                          {
                            "key": "title",
                            "label": "Title"
                          },
                          {
                            "key": "ticket",
                            "label": "Ticket",
                            "cell": "ticket"
                          },
                          {
                            "key": "checks",
                            "label": "Checks",
                            "cell": "state"
                          },
                          {
                            "key": "review",
                            "label": "Review",
                            "cell": "state"
                          },
                          {
                            "key": "updated",
