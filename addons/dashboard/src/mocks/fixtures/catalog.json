  {
    "name": "drop",
    "title": "Drop",
    "version": "0.1.0",
    "preview": true,
    "description": "Preview: files between your devices, people and workspaces. An inbox of received files, sealed drops and links with an expiry. Simulated.",
    "capabilities": [
      "network"
    ],
    "first_party": true,
    "update": null,
    "contributions": [
      {
        "slot": "nav",
        "id": "drop",
        "title": "Drop",
        "icon": "Inbox",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "stack",
              "direction": "row",
              "fit": true,
              "children": [
                { "type": "markdown", "text": "Files between devices, people and workspaces. Live apps and links to tickets go through Apps & shares." },
                { "type": "link", "label": "Open Apps & shares", "href": "/addon/publish/shares" }
              ]
            },
            {
              "type": "alert",
              "tone": "info",
              "title": "Simulated",
              "text": "Uploads, downloads and links on this page are simulated: nothing leaves this machine. In orch v2 every file is sealed end to end, and the relay stores only ciphertext."
            },
            {
              "type": "stack",
              "direction": "row",
              "children": [
                {
                  "type": "stat",
                  "label": "To claim",
                  "value": {
                    "$ref": "addon.toClaim"
                  },
                  "hint": "inbox files several workspaces got"
                },
                {
                  "type": "stat",
                  "label": "Live drops",
                  "value": {
                    "$ref": "addon.liveCount"
                  },
                  "hint": "sent, not expired"
                },
                {
                  "type": "stat",
                  "label": "Views",
                  "value": {
                    "$ref": "addon.views"
                  },
                  "hint": "all sent files"
                }
              ]
            },
            {
              "type": "markdown",
              "text": "## Inbox\nFiles sent to this workspace. A file marked **to claim** went to several workspaces: the first one to claim it handles it."
            },
            {
              "type": "table",
              "columns": [
                {
                  "key": "file",
                  "label": "File"
                },
                {
                  "key": "from",
                  "label": "From"
                },
                {
                  "key": "size",
                  "label": "Size"
                },
                {
                  "key": "received",
                  "label": "Received"
                },
                {
                  "key": "expires",
                  "label": "Expires"
                },
                {
                  "key": "ticket",
                  "label": "Ticket"
                },
                {
                  "key": "state",
                  "label": "State"
                }
              ],
              "rows": {
                "$ref": "addon.inboxRows"
              },
              "empty": "Nothing received.",
              "rowActions": [
                {
                  "label": "Claim",
                  "action": "claim",
                  "args": {
                    "id": "$row.id"
