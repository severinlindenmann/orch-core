      },
      {
        "slot": "settings",
        "id": "quick.settings",
        "title": "Quick tasks",
        "icon": "ListChecks",
        "node": {
          "type": "form",
          "schema": {
            "type": "object",
            "properties": {
              "agents_add": { "type": "boolean", "title": "Agents may add quick tasks", "default": false },
