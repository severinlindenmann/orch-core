      "disarm": {
        "minRole": "maintainer",
        "confirm": "sign",
        "label": "Disarm a schedule"
      },
      "run_now": {
        "minRole": "member",
        "label": "Run now"
      },
      "open_run": {
        "minRole": "viewer",
        "label": "Open run"
      }
    }
  }
]
