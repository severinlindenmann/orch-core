[
  {
    "name": "worktrees",
    "title": "Worktrees",
    "version": "0.1.0",
    "description": "Give each ticket its own git worktree, created and cleaned up for you.",
    "capabilities": [],
    "first_party": true,
    "package_sha256": "e160706069101712e0d86be0baaf7a2f93b0217beb27013e01a771a76fce5930",
    "update": null,
    "contributions": [
      {
        "slot": "nav",
        "id": "worktrees",
        "title": "Worktrees",
        "icon": "GitBranch",
        "node": {
          "type": "stack",
          "children": [
            {
              "$ref": "addon.addBar"
            },
            {
              "$ref": "addon.filterBar"
            },
            {
              "type": "table",
              "columns": [
                {
                  "key": "path",
                  "label": "Path"
                },
                {
                  "key": "repo",
                  "label": "Repository"
                },
                {
                  "key": "branch",
                  "label": "Branch"
                },
                {
                  "key": "ticket",
                  "label": "Ticket",
                  "cell": "ticket"
                },
                {
                  "key": "changes",
                  "label": "Changed files"
                },
                {
                  "key": "sync",
                  "label": "Ahead / behind"
                },
                {
                  "key": "by",
                  "label": "Created by"
                }
              ],
              "rows": {
                "$ref": "addon.shownRows"
              },
              "empty": "No worktrees match. Clear the filter, or add one for a ticket.",
              "rowActions": {
                "$ref": "addon.rowActions"
              }
            }
          ]
        }
      },
      {
        "slot": "ticket.panel",
        "id": "ticket",
        "title": "Worktrees",
        "icon": "GitBranch",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "list",
              "items": {
                "$ref": "addon.byTicket.$ticket"
              },
              "empty": "No worktree for this ticket."
            },
            {
              "type": "form",
              "schema": {
                "type": "object",
                "required": [
                  "repo"
                ],
                "properties": {
                  "repo": {
                    "type": "string",
                    "title": "Repository",
                    "enum": [
                      "acme-energy/energy-dbt",
                      "acme-energy/billing-api",
                      "acme-energy/ingest"
                    ]
                  },
                  "base": {
                    "type": "string",
                    "title": "Base branch",
                    "default": "main"
                  }
                }
              },
              "formData": {
                "base": "main"
              },
              "action": "add",
              "submitLabel": "Add worktree for this ticket"
            }
          ]
        }
      }
    ],
    "actions": {
      "open_terminal": {
        "minRole": "member",
        "label": "Open terminal here"
      },
      "filter": {
        "minRole": "viewer",
        "kind": "navigation",
        "label": "Filter worktrees"
      },
      "remove": {
        "minRole": "member",
        "confirm": "destructive",
        "confirmLabel": "Remove worktree",
        "confirmText": "The worktree folder is deleted from disk and the branch stays in the repository. A worktree with changed files is not removed: commit or stash them first."
      }
    }
  },
  {
    "name": "quick",
    "title": "Quick tasks",
    "version": "0.1.0",
    "description": "Jot a task in one line; an agent claims it and closes it with a line of proof, or you make it a ticket.",
    "capabilities": [],
    "first_party": true,
    "package_sha256": "54a93267b64f1a580a0efaa1b5649db3a75ee4530769da54202cc720d982ce02",
    "update": null,
    "contributions": [
      {
        "slot": "nav",
        "id": "quick",
        "title": "Quick tasks",
        "icon": "ListChecks",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "markdown",
              "text": "${addon.summaryLine}"
            },
            {
              "type": "form",
              "schema": {
                "$ref": "addon.addSchema"
              },
              "uiSchema": {
