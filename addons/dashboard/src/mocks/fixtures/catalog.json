[
  {
    "name": "worktrees",
    "title": "Worktrees",
    "version": "0.1.0",
    "description": "Give each ticket its own git worktree, created and cleaned up for you.",
    "capabilities": [],
    "first_party": true,
    "package_sha256": "e160706069101712e0d86be0baaf7a2f93b0217beb27013e01a771a76fce5930",
    "update": null,
    "contributions": [
      {
        "slot": "nav",
        "id": "worktrees",
        "title": "Worktrees",
        "icon": "GitBranch",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "stack",
              "direction": "row",
              "children": [
                {
                  "type": "stat",
                  "label": "Worktrees",
                  "value": "${addon.total}"
                },
                {
                  "type": "stat",
                  "label": "With changes",
                  "value": "${addon.dirty}"
                }
              ]
            },
            {
              "type": "markdown",
              "text": "**acme-energy/energy-dbt**"
            },
            {
              "type": "table",
              "columns": [
                {
                  "key": "path",
                  "label": "Path"
                },
                {
                  "key": "branch",
                  "label": "Branch"
                },
                {
                  "key": "ticket",
                  "label": "Ticket"
                },
                {
                  "key": "changes",
                  "label": "Changes"
                },
                {
                  "key": "sync",
                  "label": "Ahead / behind"
                },
                {
                  "key": "by",
                  "label": "Created by"
                }
              ],
              "rows": {
                "$ref": "addon.rowsByRepo.energy-dbt"
              },
              "rowActions": {
                "$ref": "addon.rowActions"
              }
            },
            {
              "type": "markdown",
              "text": "**acme-energy/billing-api**"
            },
            {
              "type": "table",
              "columns": [
                {
                  "key": "path",
                  "label": "Path"
                },
                {
                  "key": "branch",
                  "label": "Branch"
                },
                {
                  "key": "ticket",
                  "label": "Ticket"
                },
                {
                  "key": "changes",
                  "label": "Changes"
                },
                {
                  "key": "sync",
                  "label": "Ahead / behind"
                },
                {
                  "key": "by",
                  "label": "Created by"
                }
              ],
              "rows": {
                "$ref": "addon.rowsByRepo.billing-api"
              },
              "rowActions": {
                "$ref": "addon.rowActions"
              }
            },
            {
              "type": "markdown",
              "text": "**acme-energy/ingest**"
            },
            {
              "type": "table",
              "columns": [
                {
                  "key": "path",
                  "label": "Path"
                },
                {
                  "key": "branch",
                  "label": "Branch"
                },
                {
                  "key": "ticket",
                  "label": "Ticket"
                },
                {
                  "key": "changes",
                  "label": "Changes"
                },
                {
                  "key": "sync",
                  "label": "Ahead / behind"
                },
                {
                  "key": "by",
                  "label": "Created by"
                }
              ],
              "rows": {
                "$ref": "addon.rowsByRepo.ingest"
              },
              "rowActions": {
                "$ref": "addon.rowActions"
              }
            },
            {
              "type": "form",
              "schema": {
                "$ref": "addon.addSchema"
              },
              "formData": {
                "base": "main"
              },
              "action": "add",
              "submitLabel": "Add worktree"
            }
          ]
        }
      },
      {
        "slot": "ticket.panel",
        "id": "ticket",
        "title": "Worktrees",
        "icon": "GitBranch",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "list",
              "items": {
                "$ref": "addon.byTicket.$ticket"
              },
              "empty": "No worktree for this ticket."
            },
            {
              "type": "form",
              "schema": {
                "type": "object",
                "required": [
                  "repo"
                ],
                "properties": {
                  "repo": {
                    "type": "string",
                    "title": "Repository",
                    "enum": [
                      "acme-energy/energy-dbt",
                      "acme-energy/billing-api",
                      "acme-energy/ingest"
                    ]
                  },
                  "base": {
                    "type": "string",
                    "title": "Base branch",
                    "default": "main"
                  }
                }
              },
              "formData": {
                "base": "main"
              },
              "action": "add",
              "submitLabel": "Add worktree for this ticket"
            }
          ]
        }
      }
    ],
    "actions": {
      "open_terminal": {
        "minRole": "member",
        "label": "Open terminal here"
      }
    }
  },
  {
    "name": "quick",
    "title": "Quick tasks",
    "version": "0.1.0",
    "description": "Jot a task in one line; an agent claims it and closes it with a line of proof, or you make it a ticket.",
    "capabilities": [],
    "first_party": true,
    "package_sha256": "54a93267b64f1a580a0efaa1b5649db3a75ee4530769da54202cc720d982ce02",
    "update": null,
    "contributions": [
      {
        "slot": "nav",
        "id": "quick",
        "title": "Quick tasks",
        "icon": "ListChecks",
        "node": {
          "type": "stack",
          "children": [
            {
              "type": "stack",
              "direction": "row",
              "children": [
                { "type": "stat", "label": "Open", "value": "${addon.open}" },
                { "type": "stat", "label": "Claimed", "value": "${addon.claimed}" },
                { "type": "stat", "label": "Done", "value": "${addon.done}" },
                { "type": "stat", "label": "Outgrew", "value": "${addon.outgrew}" }
              ]
            },
            { "type": "markdown", "text": "### Add a quick task" },
            {
              "type": "form",
              "schema": { "$ref": "addon.addSchema" },
              "action": "add",
              "submitLabel": "Add quick task"
            },
            { "$ref": "addon.closePanel" },
            { "type": "markdown", "text": "### Quick tasks" },
            {
              "type": "list",
              "items": { "$ref": "addon.list" },
              "empty": "No quick tasks."
            }
          ]
        }
      },
      {
        "slot": "settings",
        "id": "quick.settings",
        "title": "Quick tasks",
        "icon": "ListChecks",
        "node": {
          "type": "form",
          "schema": {
            "type": "object",
            "properties": {
              "agents_add": { "type": "boolean", "title": "Agents may add quick tasks", "default": false },
              "max_commits": { "type": "integer", "title": "Most commits", "minimum": 0, "default": 1 },
              "max_files": { "type": "integer", "title": "Most files", "minimum": 0, "default": 3 }
            }
          },
          "formData": { "$ref": "addon.settings" },
          "action": "save_settings",
          "submitLabel": "Save"
        }
      }
    ],
    "actions": {
      "save_settings": { "minRole": "owner" },
      "decide": { "minRole": "maintainer" }
    }
  },
  {
    "name": "records",
    "title": "Records",
    "version": "0.1.0",
    "description": "Commit and push the ticket records to git, so the history lives next to your code.",
    "capabilities": [],
    "first_party": true,
    "package_sha256": "02749a91b9e031f5dd09fca28091eadc437565deab515f89e26e40edd7f0a7d6",
    "update": null,
    "contributions": [
      {
        "slot": "nav",
        "id": "records",
        "title": "Records",
        "icon": "GitCommitHorizontal",
        "node": {
          "type": "stack",
          "children": [
            { "type": "stat", "label": "Not recorded yet", "value": "${addon.summary}", "hint": "${addon.lastPushText}" },
            { "$ref": "addon.pushAlert" },
            {
              "type": "stack",
              "direction": "row",
              "children": [
                { "type": "button", "label": "Commit records", "action": "commit", "variant": "primary" },
                { "type": "button", "label": "Push", "action": "push", "variant": "secondary" },
                { "type": "button", "label": "Pull", "action": "pull", "variant": "ghost" }
              ]
            },
            { "type": "markdown", "text": "Remote: `${addon.remote}`" },
            {
              "type": "table",
              "columns": [
                { "key": "ticket", "label": "Ticket" },
                { "key": "title", "label": "Title" },
                { "key": "events", "label": "Events" },
                { "key": "last", "label": "Latest" }
              ],
              "rows": { "$ref": "addon.rows" }
            },
            { "type": "markdown", "text": "### Record commits" },
            { "type": "list", "items": { "$ref": "addon.historyItems" }, "empty": "No record commits yet." }
          ]
        }
      },
      {
        "slot": "settings",
        "id": "records.settings",
        "title": "Records",
        "icon": "GitCommitHorizontal",
        "node": {
          "type": "form",
          "schema": {
            "type": "object",
            "properties": {
              "auto_commit_minutes": { "type": "integer", "title": "Auto-commit every N minutes", "minimum": 1, "maximum": 1440, "default": 30 },
              "push": { "type": "boolean", "title": "Push after committing", "default": true },
              "remote": { "type": "string", "title": "Remote", "maxLength": 200 }
            }
          },
          "formData": { "$ref": "addon.settings" },
          "action": "save_settings",
          "submitLabel": "Save"
        }
      }
    ],
    "commands": [
      { "id": "commit", "title": "Commit records", "action": "commit" },
      { "id": "push", "title": "Push records", "action": "push" }
    ],
    "actions": { "save_settings": { "minRole": "owner" } }
  },
