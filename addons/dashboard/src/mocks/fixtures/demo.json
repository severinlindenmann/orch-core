        {
          "id": "Q1",
          "to": "p_mara",
          "text": "Which tariff export is the source of truth, the monthly CSV or the API?",
          "why": "The two differ for 3 of 40 tariffs; the seed must pick one.",
          "options": [
            {
              "key": "csv",
              "label": "Monthly CSV"
            },
            {
              "key": "api",
              "label": "Tariff API",
              "cost": "+1 day"
            }
          ],
          "recommended": "csv",
          "blocking": true
        },
        {
          "id": "Q2",
          "to": "p_sev",
          "text": "Should `valid_from` in the seeds be a DATE or a TIMESTAMP?",
          "why": "Tariffs change at midnight local time, but the meter readings join on UTC timestamps. DATE is simpler, TIMESTAMP avoids a cast in fct_billing.",
          "options": [
            {
              "key": "date",
              "label": "DATE (local midnight)"
            },
            {
              "key": "timestamp",
              "label": "TIMESTAMP (UTC)",
              "cost": "+2 tests"
            }
          ],
          "recommended": "date",
          "blocking": true
        }
      ],
