    {
      "name": "set_without_a_status_filter_then_any_declared_status_wakes",
      "pins": "on = {source,kind,ref}; the wake event carries source,kind,ref,status,at",
      "steps": [
        {
          "op": "grant",
          "payload": {
            "name": "databricks",
            "version": "1.0.0",
            "capabilities": [
              "network"
            ],
            "fields": {},
            "sections": [],
            "artifact_kinds": [],
            "events": [
              {
                "kind": "run.finished",
                "title": "Run finished",
                "statuses": [
                  "succeeded",
                  "failed",
                  "cancelled"
                ],
                "ref": "int",
                "interval_s": 300
              }
            ]
          },
          "expect": null
        },
        {
          "op": "set",
          "trigger": "addon",
          "on": {
            "source": "addon",
            "kind": "databricks.run.finished",
            "ref": "8812"
          },
          "deadline_after_s": 10800,
          "expect": null
        },
        {
          "op": "fire",
          "set": 0,
          "trigger": "addon",
          "after_s": 300,
          "event": {
            "source": "addon",
            "kind": "databricks.run.finished",
            "ref": "8812",
            "status": "cancelled",
            "at_offset_s": 0
          },
          "expect": null
        }
      ]
    },
