{
  "pins": "add-on events in follow-ups (orch-core #718, addon-api 1.2): the addon.granted events shape and the followup.set / followup.fired rules. Unsigned model-level vectors: each scenario is replayed by orch.model (tests/model/test_followup_addon_vectors.py) with the placeholder verifier; a consumer that renders or checks these shapes (hub summary, dashboard, mobile) replays the same steps. Times are offsets in seconds from the moment of the step.",
  "preamble": "workspace owner sev; member tom owns a ticket and holds a workable claim; add-on schedules granted without capabilities",
  "scenarios": [
    {
      "name": "grant_with_events_is_admitted",
      "pins": "addon.granted carries the declared events flat; replay never reads a manifest",
      "steps": [
        {
          "op": "grant",
          "payload": {
            "name": "databricks",
            "version": "1.0.0",
            "capabilities": [
              "network"
            ],
            "fields": {},
            "sections": [],
            "artifact_kinds": [],
            "events": [
              {
                "kind": "run.finished",
                "title": "Run finished",
                "statuses": [
                  "succeeded",
                  "failed",
                  "cancelled"
                ],
                "ref": "int",
                "interval_s": 300
              }
            ]
          },
          "expect": null
        }
      ]
    },
    {
      "name": "grant_refuses_a_kind_declared_twice",
      "pins": "kinds are unique",
      "steps": [
        {
          "op": "grant",
