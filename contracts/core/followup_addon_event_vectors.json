                "ref": "int",
                "interval_s": 300
              },
              {
                "kind": "run.finished",
                "title": "Run finished",
                "statuses": [
                  "succeeded",
                  "failed",
                  "cancelled"
                ],
                "ref": "int",
                "interval_s": 300
              }
            ]
          },
          "expect": "addon.value_invalid"
        }
      ]
    },
