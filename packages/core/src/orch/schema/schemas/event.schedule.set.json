{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.schedule.set",
  "title": "schedule.set event",
  "description": "Manual schedule set (bounded person authority root).",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "id": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
    },
    "seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "type": {
      "const": "schedule.set"
    },
    "actor": {
      "allOf": [
        {
          "type": "object",
          "description": "Section 5.2. A person, an agent (with a grant, or unattended) or the host. An addon actor is refused in P1 (A5).",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "person",
                "agent",
                "host"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "person"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "if": {
                  "required": [
                    "via"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "person"
                    },
                    "id": {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hubUserId"
                    },
                    "via": {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "via"
                  ]
                },
                "else": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "person"
                    },
                    "id": {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                    },
                    "device": {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/deviceId"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "device"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "agent"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "for": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                      },
                      "grant": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/grantId"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "for",
                      "grant"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "unattended": {
                        "const": true
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "unattended"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "person"
              ]
            },
            "unattended": false
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "based_on": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "prev": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash_v": {
      "const": 1
    },
    "ws_seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "roster_v": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "auth": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/auth"
    },
    "sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "host_sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "channel": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
    },
    "channel_factor": {
      "enum": [
        "password+totp",
        "se-unlocked",
        "passkey"
      ]
    },
    "hub_id": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
    },
    "snapshot_version": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "channel_cert": {
      "type": "object",
      "properties": {
        "o": {
          "type": "object"
        },
        "sig": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
        }
      },
      "additionalProperties": false,
      "required": [
        "o",
        "sig"
      ]
    },
    "uk_cert": {
      "type": "object",
      "properties": {
        "o": {
          "type": "object"
        },
        "sig": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
        }
      },
      "additionalProperties": false,
      "required": [
        "o",
        "sig"
      ]
    },
    "item_hash": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "channel_proof": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "schedule": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/scheduleId"
    },
    "brief": {
      "type": "string",
      "maxLength": 4096
    },
    "label": {
      "type": "string",
      "maxLength": 200
    },
    "rule": {
      "type": "object",
      "properties": {
        "every": {
          "enum": [
            "once",
            "day",
            "week",
            "month"
          ]
        },
        "at": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?![\\s\\S])"
        },
        "tz": {
          "type": "string",
          "minLength": 1
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "every",
        "at",
        "tz"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "every": {
                "const": "week"
              }
            }
          },
          "then": {
            "required": [
              "weekdays"
            ]
          },
          "else": {
            "not": {
              "required": [
                "weekdays"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "every": {
                "const": "month"
              }
            }
          },
          "then": {
            "required": [
              "day"
            ]
          },
          "else": {
            "not": {
              "required": [
                "day"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "every": {
                "const": "once"
              }
            }
          },
          "then": {
            "required": [
              "date"
            ]
          },
          "else": {
            "not": {
              "required": [
                "date"
              ]
            }
          }
        }
      ]
    },
    "starts": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "ends": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "run_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "required": [
    "v",
    "id",
    "seq",
    "at",
    "type",
    "actor",
    "based_on",
    "prev",
    "hash_v",
    "host_sig",
    "schedule",
    "brief",
    "rule",
    "starts",
    "ends",
    "run_hours"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "required": [
          "sig",
          "auth",
          "roster_v"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "host"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "sig": {
            "not": {}
          },
          "auth": {
            "not": {}
          },
          "roster_v": {
            "not": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seq": {
            "const": 1
          }
        },
        "required": [
          "seq"
        ]
      },
      "then": {
        "properties": {
          "prev": {
            "type": "null"
          },
          "based_on": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "prev": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          },
          "based_on": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "auth": {
            "const": "hub"
          }
        },
        "required": [
          "auth"
        ]
      },
      "then": {
        "required": [
          "channel",
          "channel_factor",
          "hub_id",
          "snapshot_version",
          "channel_cert",
          "uk_cert",
          "channel_proof"
        ],
        "properties": {
          "actor": {
            "required": [
              "via"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "channel": {
            "not": {}
          },
          "channel_factor": {
            "not": {}
          },
          "hub_id": {
            "not": {}
          },
          "snapshot_version": {
            "not": {}
          },
          "channel_cert": {
            "not": {}
          },
          "uk_cert": {
            "not": {}
          },
          "channel_proof": {
            "not": {}
          },
          "item_hash": {
            "not": {}
          },
          "actor": {
            "not": {
              "required": [
                "via"
              ]
            }
          }
        }
      }
    }
  ]
}
