{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/keys-line",
  "title": "keys.jsonl line",
  "description": "Format doc section 2: one line per key, written as cj plus LF.",
  "type": "object",
  "properties": {
    "key": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ticketKey"
    },
    "uid": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
    },
    "at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "required": [
    "key",
    "uid",
    "at"
  ]
}
