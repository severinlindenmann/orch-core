{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/workspace",
  "title": "Workspace config.json",
  "description": "Format doc section 2 (config.json), T5, T8, D59, D60. Mirrors the signed workspace log; persons are unique (validate()).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "orch.workspace/2"
    },
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
        },
        "prefix": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/prefix"
        },
        "name": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
        },
        "icon": {
          "oneOf": [
            {
              "type": "object",
              "description": "The workspace icon shown in menus (dashboard, hub): an icon and a colour from closed lists, nothing else. null clears it (the default comes from the workspace id).",
              "properties": {
                "icon": {
                  "enum": [
                    "folder",
                    "rocket",
                    "briefcase",
                    "building",
                    "code",
                    "cloud",
                    "compass",
                    "globe",
                    "leaf",
                    "flame",
                    "zap",
                    "anchor",
                    "heart",
                    "star"
                  ]
                },
                "colour": {
                  "enum": [
                    "orange",
                    "blue",
                    "green",
                    "purple",
                    "pink",
                    "teal",
                    "amber",
                    "slate"
                  ]
                }
              },
              "required": [
                "icon",
                "colour"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "prefix",
        "name"
      ]
    },
    "host": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hostId"
        },
        "wsk_pub": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/pubkey"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "wsk_pub"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "person": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
          },
          "name": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
          },
          "role": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/memberRole"
          }
        },
        "additionalProperties": false,
        "required": [
          "person",
          "name",
          "role"
        ]
      },
      "minItems": 1
    },
    "gates": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatesAll"
    },
    "settings": {
      "type": "object",
      "properties": {
        "grant_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "claim_ttl_min": {
          "type": "integer",
          "minimum": 15,
          "maximum": 1440
        },
        "lease_ttl_min": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "sign_methods": {
          "type": "array",
          "description": "B6 (owner decision F, 16 Oct 2026): the ways a signature may be made in this workspace. terminal is always present; touchid is reserved and not selectable yet.",
          "items": {
            "enum": [
              "terminal",
              "click",
              "phone",
              "hub"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 4,
          "contains": {
            "const": "terminal"
          }
        },
        "repos": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/repoName"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
              },
              "remote": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/repoIdentity"
              },
              "default_branch": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/branchName"
              }
            },
            "additionalProperties": false,
            "required": [
              "path"
            ]
          }
        },
        "publish": {
          "type": "object",
          "description": "The Publish add-on's server: where shared files go (api, signed requests) and where a link opens (share). A person signs it; it is never an agent's choice. null removes it.",
          "properties": {
            "server": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/publishOrigin"
            },
            "share": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/publishOrigin"
            }
          },
          "required": [
            "server",
            "share"
          ],
          "additionalProperties": false
        },
        "icon": {
          "oneOf": [
            {
              "type": "object",
              "description": "Legacy (before D6): optional and ignored, never written again. The icon is workspace.icon (unsigned).",
              "properties": {
                "icon": {
                  "enum": [
                    "folder",
                    "rocket",
                    "briefcase",
                    "building",
                    "code",
                    "cloud",
                    "compass",
                    "globe",
                    "leaf",
                    "flame",
                    "zap",
                    "anchor",
                    "heart",
                    "star"
                  ]
                },
                "colour": {
                  "enum": [
                    "orange",
                    "blue",
                    "green",
                    "purple",
                    "pink",
                    "teal",
                    "amber",
                    "slate"
                  ]
                }
              },
              "required": [
                "icon",
                "colour"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "addons": {
          "type": "object",
          "description": "G6: the signed settings of installed add-ons, by add-on name.",
          "propertyNames": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "grant_hours",
        "claim_ttl_min",
        "lease_ttl_min",
        "repos"
      ]
    },
    "agents": {
      "type": "object",
      "properties": {
        "run_for": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/memberRole"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "run_for"
      ]
    },
    "addons": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "enabled"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace",
    "host",
    "members",
    "gates",
    "settings",
    "agents",
    "addons"
  ]
}
