{
  "v": "orch.cli/2.0",
  "ok": true,
  "data": {
    "target": "follow_up",
    "name": "follow_up",
    "cli": "orch follow-up",
    "summary": "Schedule a fresh session, release your claim, then end this session.",
    "who": "agent",
    "usage": "orch follow-up [REF] [--in DURATION] [--at WHEN] [--brief-file PATH] [--brief TEXT] [--label LABEL] [--on EVENT] [--dry-run]",
    "pre": [],
    "emits": [
      "followup.set"
    ],
    "input": {
      "type": "object",
      "description": "Schedule a fresh session, release your claim, then end this session.",
      "properties": {
        "ref": {
          "type": "string",
          "description": "ticket REF (DEMO-0043, 43); default: your claim",
          "pattern": "^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+(?:/T[1-9][0-9]*)?|T[1-9][0-9]*)$",
          "x-metavar": "REF"
        },
        "in": {
          "type": "string",
          "description": "duration: 90m, 36h or 2d",
          "x-metavar": "DURATION"
        },
        "at": {
          "type": "string",
          "description": "local time: YYYY-MM-DDTHH:MM[:SS] or +2d 09:00",
          "x-metavar": "WHEN"
        },
        "brief_file": {
          "type": "string",
          "description": "read the text from PATH, or - for stdin",
          "x-metavar": "PATH",
          "x-file": true
        },
        "brief": {
          "type": "string",
          "description": "instructions for the fresh session",
          "x-metavar": "TEXT"
        },
        "label": {
          "type": "string",
          "description": "optional label",
          "maxLength": 200
        },
        "on": {
          "type": "string",
          "description": "wake on an event instead of a time (--in/--at is then the deadline): question.answered, ticket.changed:testing, gate.approved:plan or webhook:<id from orch webhook new>",
          "x-metavar": "EVENT"
        }
      },
      "x-positional": [
        "ref"
      ],
      "required": [],
      "oneOf": [
        {
          "required": [
            "in"
          ]
        },
        {
          "required": [
            "at"
          ]
        }
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "brief"
              ]
            },
            {
              "required": [
                "brief_file"
              ]
            }
          ]
        }
      ]
    },
    "output": {
      "text": "ok {key} followup.set {id} due={due} state={state}\nnext: {next}",
      "json": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "due": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "due",
          "deadline",
          "state",
          "trigger"
        ],
        "additionalProperties": false
      }
    },
