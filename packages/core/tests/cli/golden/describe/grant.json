        "hint": "retry in a moment",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "parse.text",
        "exit": 6,
        "retryable": false,
        "hint": "orch describe grant",
        "fix": [
          "orch",
          "describe",
