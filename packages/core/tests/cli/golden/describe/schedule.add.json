{
  "v": "orch.cli/2.0",
  "ok": true,
  "data": {
    "target": "schedule.add",
    "name": "schedule.add",
    "cli": "orch schedule add",
    "summary": "Schedule automatic agent sessions on an existing ticket or a new ticket each run, for up to 30 days.",
    "who": "human",
    "usage": "orch schedule add [REF] [--target existing|new] [--title TITLE] --at AT [--every day|week|month] [--tz TZ] [--weekdays WEEKDAYS] [--day DAY] [--brief BRIEF] [--brief-file PATH] [--until UNTIL] [--run-hours RUN_HOURS] [--dry-run]",
    "pre": [],
    "emits": [
      "ticket.created",
      "schedule.set"
    ],
    "input": {
      "type": "object",
      "description": "Schedule automatic agent sessions on an existing ticket or a new ticket each run, for up to 30 days.",
      "properties": {
        "ref": {
          "type": "string",
          "description": "ticket REF; required for target existing",
          "pattern": "^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+(?:/T[1-9][0-9]*)?|T[1-9][0-9]*)$",
          "x-metavar": "REF"
        },
        "target": {
          "type": "string",
          "description": "existing or new ticket",
          "enum": [
            "existing",
            "new"
          ],
          "default": "existing"
        },
        "title": {
          "type": "string",
          "description": "literal title for each new ticket",
          "minLength": 1,
          "maxLength": 100
        },
        "at": {
          "type": "string",
          "description": "once: YYYY-MM-DD HH:MM; recurring: HH:MM"
        },
        "every": {
          "type": "string",
          "description": "day, week or month",
          "enum": [
            "day",
            "week",
            "month"
          ]
        },
        "tz": {
          "type": "string",
          "description": "IANA timezone; default UTC"
        },
        "weekdays": {
          "type": "string",
          "description": "comma-separated weekdays 0..6, Monday=0"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31,
          "description": "monthly day; clamps to the last day of shorter months"
        },
        "brief": {
          "type": "string",
          "description": "the brief as text",
          "maxLength": 4096
        },
        "brief_file": {
          "type": "string",
          "description": "read the text from PATH, or - for stdin",
          "x-metavar": "PATH",
          "x-file": true
        },
        "until": {
          "type": "string",
          "description": "end instant; defaults to 30 days"
        },
        "run_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "maximum hours per run; default 8"
        }
      },
      "x-positional": [
        "ref"
      ],
      "required": [
        "at"
      ],
      "additionalProperties": false
    },
    "output": {
      "text": "ok {key} schedule.set {id} seq={seq}\nnext: {next}",
      "json": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
