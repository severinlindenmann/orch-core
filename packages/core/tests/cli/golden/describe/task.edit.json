{
  "v": "orch.cli/2.0",
  "ok": true,
  "data": {
    "target": "task.edit",
    "name": "task.edit",
    "cli": "orch task edit",
    "summary": "Change a task's text, its verify command or the criteria it proves. A task that is done keeps its verify command and its criteria.",
    "who": "agent",
    "usage": "orch task edit TASK [--text TEXT] [--verify CMD] [--proves AC1,AC2] [--ref REF] [--dry-run]",
    "pre": [
      "ticket_exists",
      "ticket_open_for_work",
      "task_exists",
      "acceptance_exists",
      "base_rev_tracked",
      "grant_valid",
      "text_clean"
    ],
    "emits": [
      "ticket.updated"
    ],
    "input": {
      "type": "object",
      "description": "Change a task's text, its verify command or the criteria it proves. A task that is done keeps its verify command and its criteria.",
      "properties": {
        "task": {
          "type": "string",
          "description": "task id (T3 or DEMO-0043/T3)",
          "pattern": "^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+/)?T[1-9][0-9]*$",
          "x-metavar": "TASK"
        },
        "text": {
          "type": "string",
          "description": "the new text of the task",
          "x-metavar": "TEXT"
        },
        "verify": {
          "type": "string",
          "description": "the new verify command; an empty value removes it",
          "x-metavar": "CMD"
        },
        "proves": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AC[1-9][0-9]*$"
          },
          "description": "the criteria it proves, comma separated (through the host API an empty list proves none)",
          "x-metavar": "AC1,AC2",
          "x-split": ","
        },
        "ref": {
          "type": "string",
          "description": "ticket REF (flag)",
          "pattern": "^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+(?:/T[1-9][0-9]*)?|T[1-9][0-9]*)$",
          "x-metavar": "REF"
        }
      },
      "x-positional": [
        "task"
      ],
      "required": [
        "task"
      ],
      "additionalProperties": false
    },
    "output": {
      "text": "ok {key} ticket.updated {task} seq={seq}\nnext: {next}",
      "json": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      }
    },
    "errors": [
      {
        "code": "ambiguous_ref",
        "exit": 2,
        "retryable": false,
        "hint": "name the ticket REF, for example DEMO-0043",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "not_found",
        "exit": 2,
        "retryable": false,
        "hint": "orch list",
        "fix": [
          "orch",
          "list"
        ]
      },
      {
        "code": "grant.expired",
        "exit": 3,
        "retryable": false,
        "hint": "ask the person for a new grant",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "grant.required",
        "exit": 3,
        "retryable": false,
        "hint": "ask the person to run orch grant, then set ORCH_GRANT",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "sign.cancelled",
        "exit": 3,
        "retryable": false,
        "hint": "run it again to review",
        "fix": [
          "orch",
          "help"
        ]
      },
      {
        "code": "transition.refused",
        "exit": 3,
        "retryable": false,
        "hint": "orch show REF",
        "fix": [
          "orch",
          "show"
        ]
      },
      {
        "code": "tty.required",
        "exit": 3,
        "retryable": false,
        "hint": "run it in your terminal",
        "fix": [
          "orch",
          "help"
        ]
      },
      {
        "code": "lock.busy",
        "exit": 4,
        "retryable": true,
        "hint": "retry in a moment",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "parse.text",
        "exit": 6,
        "retryable": false,
        "hint": "orch describe task.edit",
        "fix": [
          "orch",
          "describe",
          "task.edit"
        ]
      },
      {
        "code": "conflict.field",
        "exit": 8,
        "retryable": true,
        "hint": "orch show, then redo the edit",
        "fix": [
          "orch",
          "show"
        ]
      }
    ]
  },
  "key": null,
  "seq": 0,
  "cursor": 0,
  "hints": []
}
