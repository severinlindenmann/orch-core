#!/bin/sh
# orch CLI bundled with the orch-core plugin. Needs uv: https://docs.astral.sh/uv/
# Never exits 2: Claude Code treats exit 2 from a hook as "block", so any failure here
# (uv error, read-only plugin folder, ...) must not block tool calls. The guard denies via JSON.
case "$0" in */*) here=${0%/*} ;; *) here=. ;; esac
if ! command -v uv >/dev/null 2>&1; then
  echo "orch: uv is not installed (https://docs.astral.sh/uv/getting-started/installation/); skipping." >&2
  exit 127
fi
if [ -n "${CLAUDE_PLUGIN_DATA:-}" ]; then
  # Keep the venv in the plugin's data folder, not in the (possibly read-only) plugin folder.
  UV_PROJECT_ENVIRONMENT="$CLAUDE_PLUGIN_DATA/venv"
  export UV_PROJECT_ENVIRONMENT
fi
uv run --quiet --frozen --project "$here/.." orch "$@"
status=$?
# Keep orch's own exit codes (e.g. 5 from `orch check`); only 2 would block, so map it to 1.
if [ "$status" -eq 2 ]; then
  exit 1
fi
exit "$status"
