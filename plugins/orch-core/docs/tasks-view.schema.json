{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orch.local/schemas/orch.tasks.v1/tasks-view.schema.json",
  "title": "orch.tasks.v1 task-list view",
  "description": "What `orch task list <id> --json` returns (also `tasks` in `orch show --json`). See docs/tasks-format.md.",
  "type": "object",
  "required": ["format", "ticket", "status", "error", "summary", "doing", "next", "open",
               "can_move_to_testing", "plan_approved", "added_since_approval", "tasks"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "orch.tasks.v1"},
    "ticket": {"type": "string"},
    "status": {"enum": ["backlog", "open", "in-progress", "waiting", "testing", "done"]},
    "error": {"type": ["string", "null"]},
    "line": {"type": "integer", "minimum": 1, "description": "only with an error: the section line"},
    "summary": {
      "type": "object",
      "required": ["total", "todo", "doing", "done", "skipped", "blocked", "closed"],
      "additionalProperties": false,
      "properties": {
        "total": {"$ref": "#/$defs/count"}, "todo": {"$ref": "#/$defs/count"},
        "doing": {"$ref": "#/$defs/count"}, "done": {"$ref": "#/$defs/count"},
        "skipped": {"$ref": "#/$defs/count"}, "blocked": {"$ref": "#/$defs/count"},
        "closed": {"$ref": "#/$defs/count"}
      }
    },
    "doing": {"anyOf": [{"$ref": "#/$defs/taskId"}, {"type": "null"}]},
    "next": {"anyOf": [{"$ref": "#/$defs/taskId"}, {"type": "null"}]},
    "open": {"type": "array", "items": {"$ref": "#/$defs/taskId"}},
    "can_move_to_testing": {"type": "boolean"},
    "plan_approved": {"type": ["string", "null"]},
    "added_since_approval": {"$ref": "#/$defs/count"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "taskId": {"type": "string", "pattern": "^T[1-9][0-9]*$"},
    "nullableString": {"type": ["string", "null"]},
    "task": {
      "type": "object",
      "required": ["id", "state", "text", "owner", "needs", "needs_open", "refs", "verify", "why", "on",
                   "on_ref", "note", "added", "added_after_approval", "waits_on_you"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/taskId"},
        "state": {"enum": ["todo", "doing", "done", "skipped", "blocked"]},
        "text": {"type": "string", "minLength": 1},
        "owner": {"enum": ["agent", "human"]},
        "needs": {"type": "array", "items": {"$ref": "#/$defs/taskId"}},
        "needs_open": {"type": "array", "items": {"$ref": "#/$defs/taskId"}},
        "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "verify": {"$ref": "#/$defs/nullableString"},
        "why": {"$ref": "#/$defs/nullableString"},
        "on": {"$ref": "#/$defs/nullableString"},
        "on_ref": {"anyOf": [{"$ref": "#/$defs/onRef"}, {"type": "null"}]},
        "note": {"$ref": "#/$defs/nullableString"},
        "added": {"$ref": "#/$defs/nullableString"},
        "added_after_approval": {"type": "boolean"},
        "waits_on_you": {"type": "boolean"}
      }
    },
    "ref": {
      "type": "object",
      "required": ["kind", "target", "label", "exists"],
      "properties": {
        "kind": {"enum": ["file", "static", "artifact", "ticket", "ext", "url", "section", "ac", "q"]},
        "target": {"type": "string", "minLength": 1},
        "label": {"$ref": "#/$defs/nullableString"},
        "exists": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "file"}}},
         "then": {"required": ["repo", "path", "lines"],
                  "properties": {"repo": {"$ref": "#/$defs/nullableString"}, "path": {"type": "string"},
                                 "lines": {"$ref": "#/$defs/nullableString"}},
                  "propertyNames": {"enum": ["kind", "target", "label", "exists", "repo", "path", "lines"]}}},
        {"if": {"properties": {"kind": {"const": "static"}}},
         "then": {"required": ["path", "lines"],
                  "properties": {"path": {"type": "string"}, "lines": {"$ref": "#/$defs/nullableString"}},
                  "propertyNames": {"enum": ["kind", "target", "label", "exists", "path", "lines"]}}},
        {"if": {"properties": {"kind": {"const": "artifact"}}},
         "then": {"required": ["url"], "properties": {"url": {"type": "string"}},
                  "propertyNames": {"enum": ["kind", "target", "label", "exists", "url"]}}},
        {"if": {"properties": {"kind": {"const": "ticket"}}},
         "then": {"required": ["resolved", "status", "title"],
                  "properties": {"resolved": {"$ref": "#/$defs/nullableString"},
                                 "status": {"$ref": "#/$defs/nullableString"},
                                 "title": {"$ref": "#/$defs/nullableString"}},
                  "propertyNames": {"enum": ["kind", "target", "label", "exists", "resolved", "status", "title"]}}},
        {"if": {"properties": {"kind": {"enum": ["ext", "url"]}}},
         "then": {"required": ["url"], "properties": {"url": {"$ref": "#/$defs/nullableString"}},
                  "propertyNames": {"enum": ["kind", "target", "label", "exists", "url"]}}},
        {"if": {"properties": {"kind": {"const": "section"}}},
         "then": {"propertyNames": {"enum": ["kind", "target", "label", "exists"]}}},
        {"if": {"properties": {"kind": {"const": "ac"}}},
         "then": {"required": ["text"], "properties": {"text": {"$ref": "#/$defs/nullableString"}},
                  "propertyNames": {"enum": ["kind", "target", "label", "exists", "text"]}}},
        {"if": {"properties": {"kind": {"const": "q"}}},
         "then": {"required": ["text", "answered"],
                  "properties": {"text": {"$ref": "#/$defs/nullableString"}, "answered": {"type": "boolean"}},
                  "propertyNames": {"enum": ["kind", "target", "label", "exists", "text", "answered"]}}}
      ]
    },
    "onRef": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "exists", "answered"],
         "properties": {"kind": {"const": "question"}, "id": {"type": "string", "pattern": "^Q[0-9]+$"},
                        "exists": {"type": "boolean"}, "answered": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "exists", "state", "owner"],
         "properties": {"kind": {"const": "task"}, "id": {"$ref": "#/$defs/taskId"}, "exists": {"type": "boolean"},
                        "state": {"enum": ["todo", "doing", "done", "skipped", "blocked", null]},
                        "owner": {"enum": ["agent", "human", null]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "exists", "status", "title"],
         "properties": {"kind": {"const": "ticket"}, "id": {"type": "string"}, "exists": {"const": true},
                        "status": {"type": "string"}, "title": {"$ref": "#/$defs/nullableString"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "exists", "url"],
         "properties": {"kind": {"const": "ext"}, "id": {"type": "string"}, "exists": {"type": "boolean"},
                        "url": {"$ref": "#/$defs/nullableString"}}}
      ]
    }
  }
}
