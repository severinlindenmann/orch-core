{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "customer", "id"],
  "$defs": {
    "since": {"type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2}|[0-9a-fA-F]{7,40})$"}
  },
  "properties": {
    "schema": {"const": 1},
    "customer": {"type": "string"},
    "harnesses": {"type": "array", "items": {"type": "string"}},
    "id": {
      "type": "object",
      "required": ["prefix", "pad"],
      "properties": {
        "prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*$"},
        "pad": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "external_trackers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prefix", "pattern", "url"],
        "properties": {
          "prefix": {"type": "string"},
          "pattern": {"type": "string"},
          "type": {"type": "string"},
          "url": {"type": "string"}
        }
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "base_url": {"type": "string"},
        "review_term": {"enum": ["PR", "MR"]},
        "repos": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {"type": "string"},
              "default_branch": {"type": "string"},
              "review_url": {"type": "string"},
              "type": {"type": "string", "minLength": 1},
              "base_url": {"type": "string", "pattern": "^(https?://\\S+)?$"},
              "commit_check": {"enum": ["enforce", "warn", "off"]},
              "commit_skip": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "branch_pattern": {"type": "string"},
        "agent_may": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit": {"type": "boolean"},
            "push": {"type": "boolean"},
            "open_review": {"type": "boolean"}
          }
        }
      }
    },
    "wiki": {"type": "object"},
    "commit": {
      "type": "object",
      "properties": {
        "subject": {"type": "string"},
        "body": {"type": "array", "items": {"type": "string"}},
        "rollback": {"type": "boolean"},
        "forbid_attribution": {"type": "boolean"},
        "skip": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "check": {
      "type": "object",
      "properties": {
        "since": {"oneOf": [
          {"$ref": "#/$defs/since"},
          {"type": "object", "additionalProperties": {"$ref": "#/$defs/since"}}
        ]}
      }
    },
    "gates": {"type": "object", "properties": {"plan_skip_sizes": {"type": "array", "items": {"enum": ["xs", "s", "m", "l"]}},
                                             "requirements_skip_sizes": {"type": "array", "items": {"enum": ["xs", "s", "m", "l"]}}}},
    "claims": {"type": "object", "properties": {"ttl_hours": {"type": "number", "exclusiveMinimum": 0}}},
    "artifacts": {"type": "object", "properties": {"mode": {"type": "string"}, "max_mb": {"type": "number", "exclusiveMinimum": 0}}},
    "temporary": {"type": "object", "properties": {"max_age_days": {"type": "integer", "minimum": 1}}},
    "dashboard": {
      "type": "object",
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "pull_seconds": {"type": "number", "minimum": 5},
        "theme": {"enum": ["system", "light", "dark"]},
        "brand": {"type": "string"},
        "stale_minutes": {"type": "integer", "minimum": 1},
        "revalidate_days": {"type": "integer", "minimum": 0},
        "authoring_hints": {"type": "boolean"}
      }
    },
    "agents": {
      "type": "object",
      "properties": {
        "default_harness": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "prompts": {
          "type": "object",
          "propertyNames": {"enum": ["refine", "work", "fix-checks", "continue"]},
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "widgets": {"type": "object", "additionalProperties": false, "properties": {"html": {"type": "boolean"}}},
    "addons": {"type": "object", "additionalProperties": {"type": "object"}},
    "feedback": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
    "factory": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
    "quick": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,5}$"},
        "next": {"enum": ["idle", "first", "never"]},
        "max_artifacts": {"type": "integer", "minimum": 0, "maximum": 20},
        "claim_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "enabled": {"type": "boolean"},
        "agents_add": {"type": "boolean"},
        "max_commits": {"type": "integer"},
        "max_files": {"type": "integer"}
      }
    },
    "checks": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,39}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["steps"],
        "properties": {
          "steps": {"type": "array", "minItems": 1, "maxItems": 20, "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "run"],
            "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 60},
                           "run": {"type": "string", "minLength": 1, "maxLength": 2000}}}},
          "keep_going": {"type": "boolean"},
          "timeout": {"type": "integer", "minimum": 1, "maximum": 86400}
        }
      }
    },
    "suggested_addons": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "sprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
