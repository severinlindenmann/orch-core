{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/addon-manifest",
  "title": "Addon manifest (orch-addon.json)",
  "description": "Format doc section 8, minimal P1 manifest. Unknown keys are refused; needs, cli, skills and agents_md (deferred to C9) are accepted only empty. Custom addon events are refused in P1, so there are no event keys. Unique section ids and artifact kinds are checked in validate().",
  "type": "object",
  "properties": {
    "schema": {
      "const": "orch.addon/2"
    },
    "name": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
    },
    "version": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/semver"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^(?:[^()·:\\n]+)(?![\\s\\S])",
      "description": "no ( ) middle-dot or colon; invisible characters are refused by validate()"
    },
    "entry": {
      "type": "object",
      "properties": {
        "cmd": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "cmd"
      ]
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "string"
              },
              "max_len": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "show": {
                "type": "boolean"
              },
              "filter": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "max_len": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "show": {
                "type": "boolean"
              },
              "filter": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "integer"
              },
              "min": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/safeInt"
              },
              "max": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/safeInt"
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "show": {
                "type": "boolean"
              },
              "filter": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "boolean"
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "show": {
                "type": "boolean"
              },
              "filter": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "enum"
              },
              "values": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "show": {
                "type": "boolean"
              },
              "filter": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "set_by",
              "values"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "string_list"
              },
              "max_items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "show": {
                "type": "boolean"
              },
              "filter": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "person"
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "show": {
                "type": "boolean"
              },
              "filter": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^(?:[^\\n]+)(?![\\s\\S])"
          },
          "after": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/sectionId"
          },
          "gate": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "types": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/ticketType"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "heading",
          "after",
          "types"
        ]
      }
    },
    "artifact_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "allOf": [
              {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
              },
              {
                "not": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/coreArtifactKind"
                }
              }
            ]
          },
          "label": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "label"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/capability"
      },
      "uniqueItems": true
    },
    "needs": {
      "type": "array",
      "maxItems": 0,
      "description": "deferred to C9: accepted only empty"
    },
    "cli": {
      "type": "object",
      "maxProperties": 0,
      "description": "deferred to C9: accepted only empty"
    },
    "skills": {
      "type": "array",
      "maxItems": 0,
      "description": "deferred to C9: accepted only empty"
    },
    "agents_md": {
      "const": "",
      "description": "deferred to C9: accepted only empty"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "title",
    "entry"
  ]
}
