{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/artifact",
  "title": "Artifact manifest entry",
  "description": "Format doc section 6: an entry of the manifest that artifact.added / artifact.replaced events build. A file artifact has sha256 (sha256:<hex>) and bytes; an addon artifact has addon and ref instead. The actor is the one of the event; a feedback artifact needs a person.",
  "allOf": [
    {
      "required": [
        "actor"
      ],
      "if": {
        "required": [
          "addon"
        ]
      },
      "then": {
        "properties": {
          "name": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
          },
          "task": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
          },
          "ac": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
          },
          "label": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
          },
          "kind": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
          },
          "addon": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
          },
          "ref": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
          },
          "actor": {
            "$ref": "https://schemas.orch.dev/v2/event#/$defs/actor"
          },
          "sha256": {
            "not": {}
          },
          "bytes": {
            "not": {}
          }
        },
        "required": [
          "name",
          "kind",
          "addon",
          "ref"
        ]
      },
      "else": {
        "properties": {
          "name": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
          },
          "task": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
          },
          "ac": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
          },
          "label": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
          },
          "kind": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/coreArtifactKind"
          },
          "sha256": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          },
          "bytes": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
          },
          "actor": {
            "$ref": "https://schemas.orch.dev/v2/event#/$defs/actor"
          },
          "addon": {
            "not": {}
          },
          "ref": {
            "not": {}
          }
        },
        "required": [
          "name",
          "kind",
          "sha256",
          "bytes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "name": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
    },
    "task": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
    },
    "ac": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
    },
    "label": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
    },
    "kind": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
    },
    "sha256": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "bytes": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "addon": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
    },
    "ref": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
    },
    "actor": {
      "$ref": "https://schemas.orch.dev/v2/event#/$defs/actor"
    }
  },
  "unevaluatedProperties": false
}
