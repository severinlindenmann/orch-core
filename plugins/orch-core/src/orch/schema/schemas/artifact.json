{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/artifact",
  "title": "Artifact manifest entry",
  "description": "Format doc section 6: one entry derived from artifact.added / artifact.replaced events. A file artifact has sha256+bytes; an addon artifact has addon+ref instead of a file. Feedback artifacts need a person actor.",
  "$defs": {
    "fields": {
      "if": {
        "required": [
          "addon"
        ]
      },
      "then": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "task": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
          },
          "ac": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
          },
          "label": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
          },
          "kind": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
          },
          "addon": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
          },
          "ref": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
          }
        },
        "required": [
          "name",
          "kind",
          "addon",
          "ref"
        ]
      },
      "else": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "task": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
          },
          "ac": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
          },
          "label": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
          },
          "kind": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/coreArtifactKind"
          },
          "sha256": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hexSha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "kind",
          "sha256",
          "bytes"
        ]
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/artifact#/$defs/fields"
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            }
          }
        },
        "required": [
          "actor"
        ]
      }
    }
  ],
  "properties": {
    "actor": {
      "$ref": "https://schemas.orch.dev/v2/event#/$defs/actor"
    }
  },
  "required": [
    "actor"
  ],
  "unevaluatedProperties": false
}
