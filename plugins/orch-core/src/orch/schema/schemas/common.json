{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/common",
  "title": "Shared definitions",
  "description": "Primitive types shared by all v2 schemas (ids, hashes, timestamps, enums).",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)Z$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hexSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sig": {
      "type": "string",
      "pattern": "^p256:[A-Za-z0-9_+/-]+={0,2}$"
    },
    "pubkey": {
      "type": "string",
      "pattern": "^p256:[A-Za-z0-9_+/-]+={0,2}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "addonName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "personId": {
      "type": "string",
      "pattern": "^p_[A-Za-z0-9]+$"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^d_[A-Za-z0-9]+$"
    },
    "hostId": {
      "type": "string",
      "pattern": "^h_[A-Za-z0-9]+$"
    },
    "grantId": {
      "type": "string",
      "pattern": "^gr_[A-Za-z0-9]+$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^s_[A-Za-z0-9]+(\\.[A-Za-z0-9]+)*$"
    },
    "ticketKey": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{4,}$"
    },
    "prefix": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,15}$"
    },
    "acId": {
      "type": "string",
      "pattern": "^AC[0-9]+$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^T[0-9]+$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^Q[0-9]+$"
    },
    "gateName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "memberRole": {
      "enum": [
        "owner",
        "maintainer",
        "member",
        "viewer"
      ]
    },
    "ticketRole": {
      "enum": [
        "owner",
        "assignees",
        "reviewers",
        "watchers"
      ]
    },
    "approverRole": {
      "enum": [
        "owner",
        "maintainer",
        "member",
        "assignees",
        "reviewers",
        "watchers"
      ]
    },
    "ticketType": {
      "enum": [
        "feature",
        "bug",
        "chore",
        "spike",
        "investigation",
        "epic"
      ]
    },
    "sectionId": {
      "enum": [
        "summary",
        "context",
        "requirements",
        "out_of_scope",
        "plan",
        "decisions",
        "verification",
        "findings",
        "current_state"
      ]
    },
    "coreArtifactKind": {
      "enum": [
        "screenshot",
        "log",
        "report",
        "link",
        "dataset",
        "build",
        "diagram",
        "receipt",
        "feedback",
        "other"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "int": {
      "type": "integer"
    },
    "nonNegInt": {
      "type": "integer",
      "minimum": 0
    },
    "gatePolicy": {
      "type": "object",
      "properties": {
        "approvers": {
          "oneOf": [
            {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverRole"
            },
            {
              "type": "array",
              "items": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverRole"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "not": {
          "oneOf": [
            {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverRole"
            },
            {
              "type": "array",
              "items": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverRole"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "approvers",
        "count"
      ]
    },
    "gates": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
      },
      "additionalProperties": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatePolicy"
      }
    }
  }
}
