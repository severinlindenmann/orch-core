{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event-host",
  "title": "Event envelope without actor",
  "description": "Internal: envelope for host-written events (edit.external, projection.repaired) that carry no actor.",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "id": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
    },
    "actor": {
      "$ref": "https://schemas.orch.dev/v2/event#/$defs/actor"
    },
    "based_on": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "prev": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash_v": {
      "type": "integer",
      "minimum": 1
    },
    "sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "host_sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "presence": {
      "enum": [
        "touchid",
        "password",
        "passkey"
      ]
    },
    "list_seq": {
      "type": "integer",
      "minimum": 0
    },
    "policy_hash": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    }
  },
  "required": [
    "v",
    "id",
    "seq",
    "at",
    "type",
    "based_on",
    "prev",
    "hash_v",
    "host_sig"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "sig"
              ]
            },
            {
              "required": [
                "presence"
              ]
            }
          ]
        }
      }
    }
  ]
}
