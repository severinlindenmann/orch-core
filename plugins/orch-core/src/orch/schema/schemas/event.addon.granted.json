{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.addon.granted",
  "title": "addon.granted event",
  "description": "Section 8: addon.granted {name, version, package_sha256, capabilities}.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "required": [
        "sig",
        "presence"
      ],
      "properties": {
        "actor": {
          "properties": {
            "kind": {
              "const": "person"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "addon.granted"
    },
    "name": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
    },
    "version": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
    },
    "package_sha256": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hexSha256"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "type",
    "name",
    "version",
    "package_sha256",
    "capabilities"
  ],
  "unevaluatedProperties": false
}
