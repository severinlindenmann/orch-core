{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.addon.granted",
  "title": "addon.granted event",
  "description": "5.4.2, 8, 8.1. Owner only. Replay checks every later addon write against fields, sections and artifact_kinds; it never reads the manifest.",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "id": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
    },
    "seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "type": {
      "const": "addon.granted"
    },
    "actor": {
      "allOf": [
        {
          "type": "object",
          "description": "Section 5.2. A person, an agent (with a grant, or unattended) or the host. An addon actor is refused in P1 (A5).",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "person",
                "agent",
                "host"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "person"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "person"
                  },
                  "id": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                  },
                  "device": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/deviceId"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "device"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "agent"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "for": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                      },
                      "grant": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/grantId"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "for",
                      "grant"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "unattended": {
                        "const": true
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "unattended"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "person"
              ]
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "based_on": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "prev": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash_v": {
      "const": 1
    },
    "ws_seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "roster_v": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "auth": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/auth"
    },
    "sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "host_sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "name": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
    },
    "version": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/semver"
    },
    "package_sha256": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/capability"
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "string"
              },
              "max_len": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "max_len": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "integer"
              },
              "min": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/safeInt"
              },
              "max": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/safeInt"
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "boolean"
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "enum"
              },
              "values": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "type",
              "set_by",
              "values"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "string_list"
              },
              "max_items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "person"
              },
              "set_by": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/approverToken"
                    },
                    {
                      "enum": [
                        "agent",
                        "addon"
                      ]
                    }
                  ]
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "gate": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "required": [
              "type",
              "set_by"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "the declared fields: type, limits, set_by and the optional gate; no show or filter (display hints grant nothing)"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:[a-z][a-z0-9-]{0,39}\\.[a-z][a-z0-9_]*)(?![\\s\\S])",
            "description": "always <addon>.<token> with the prefix equal to name (validate())"
          },
          "types": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/ticketType"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "gate": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "types"
        ]
      }
    },
    "artifact_kinds": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
          },
          {
            "not": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/coreArtifactKind"
            }
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "v",
    "id",
    "seq",
    "at",
    "type",
    "actor",
    "based_on",
    "prev",
    "hash_v",
    "host_sig",
    "name",
    "version",
    "package_sha256",
    "capabilities",
    "fields",
    "sections",
    "artifact_kinds"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "required": [
          "sig",
          "auth",
          "roster_v"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "host"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "sig": {
            "not": {}
          },
          "auth": {
            "not": {}
          },
          "roster_v": {
            "not": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seq": {
            "const": 1
          }
        },
        "required": [
          "seq"
        ]
      },
      "then": {
        "properties": {
          "prev": {
            "type": "null"
          },
          "based_on": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "prev": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          },
          "based_on": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          }
        }
      }
    }
  ]
}
