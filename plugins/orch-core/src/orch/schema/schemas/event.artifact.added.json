{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.artifact.added",
  "title": "artifact.added event",
  "description": "5.4.1, 6. A file artifact has sha256 and bytes; an addon artifact has addon and ref instead. feedback only from a person. Unattended: no ac, no task.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorU"
        }
      }
    },
    {
      "if": {
        "required": [
          "addon"
        ]
      },
      "then": {
        "properties": {
          "name": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
          },
          "task": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
          },
          "ac": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
          },
          "label": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
          },
          "kind": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
          },
          "addon": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
          },
          "ref": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
          }
        },
        "required": [
          "name",
          "kind",
          "addon",
          "ref"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "bytes"
              ]
            }
          ]
        }
      },
      "else": {
        "properties": {
          "name": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
          },
          "task": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
          },
          "ac": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
          },
          "label": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
          },
          "kind": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/coreArtifactKind"
          },
          "sha256": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          },
          "bytes": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
          }
        },
        "required": [
          "name",
          "kind",
          "sha256",
          "bytes"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "addon"
              ]
            },
            {
              "required": [
                "ref"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "required": [
              "unattended"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "ac"
              ]
            },
            {
              "required": [
                "task"
              ]
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "artifact.added"
    },
    "name": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
    },
    "task": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
    },
    "ac": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
    },
    "label": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
    },
    "kind": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
    },
    "sha256": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "bytes": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "addon": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
    },
    "ref": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
    }
  },
  "required": [
    "type",
    "name",
    "kind"
  ],
  "unevaluatedProperties": false
}
