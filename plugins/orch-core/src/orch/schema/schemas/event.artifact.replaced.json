{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.artifact.replaced",
  "title": "artifact.replaced event",
  "description": "5.4.1, 6. A file artifact has sha256 and bytes; an addon artifact has addon and ref instead (replacing is for files only: the old digest is in replaces). feedback only from a person. Unattended: no ac, no task.",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "id": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
    },
    "seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "type": {
      "const": "artifact.replaced"
    },
    "actor": {
      "allOf": [
        {
          "type": "object",
          "description": "Section 5.2. A person, an agent (with a grant, or unattended) or the host. An addon actor is refused in P1 (A5).",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "person",
                "agent",
                "host"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "person"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "person"
                  },
                  "id": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                  },
                  "device": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/deviceId"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "device"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "agent"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "for": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                      },
                      "grant": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/grantId"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "for",
                      "grant"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "unattended": {
                        "const": true
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "unattended"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "person",
                "agent"
              ]
            },
            "unattended": false
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "based_on": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "prev": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash_v": {
      "const": 1
    },
    "ws_seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "roster_v": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "auth": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/auth"
    },
    "sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "host_sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "name": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
    },
    "task": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
    },
    "ac": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
    },
    "label": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
    },
    "kind": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
    },
    "sha256": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "bytes": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "replaces": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    }
  },
  "required": [
    "v",
    "id",
    "seq",
    "at",
    "type",
    "actor",
    "based_on",
    "prev",
    "hash_v",
    "host_sig",
    "name",
    "kind"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "required": [
          "sig",
          "auth",
          "roster_v"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "host"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "sig": {
            "not": {}
          },
          "auth": {
            "not": {}
          },
          "roster_v": {
            "not": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seq": {
            "const": 1
          }
        },
        "required": [
          "seq"
        ]
      },
      "then": {
        "properties": {
          "prev": {
            "type": "null"
          },
          "based_on": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "prev": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          },
          "based_on": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          }
        }
      }
    },
    {
      "properties": {
        "name": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
        },
        "task": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
        },
        "ac": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/acId"
        },
        "label": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
        },
        "kind": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/coreArtifactKind"
        },
        "sha256": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        "bytes": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
        },
        "replaces": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        "addon": {
          "not": {}
        },
        "ref": {
          "not": {}
        }
      },
      "required": [
        "name",
        "kind",
        "sha256",
        "bytes",
        "replaces"
      ]
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "required": [
              "unattended"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "ac": {
            "not": {}
          },
          "task": {
            "not": {}
          }
        }
      }
    }
  ]
}
