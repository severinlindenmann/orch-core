{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.claim.released",
  "title": "claim.released event",
  "description": "T7/section 5: release, including member removal.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "not": {
        "required": [
          "sig"
        ]
      }
    }
  ],
  "properties": {
    "type": {
      "const": "claim.released"
    },
    "reason": {
      "enum": [
        "released",
        "member_removed",
        "handoff"
      ]
    }
  },
  "required": [
    "type"
  ],
  "unevaluatedProperties": false
}
