{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.claim.released",
  "title": "claim.released event",
  "description": "5.4.1, 5.2, 5.12. An agent releases its own claim (released, handoff); a person names a live claim (released); the host ends one for expired, grant_ended, member_removed, ticket_done, ticket_closed (validate()).",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorAH"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "claim.released"
    },
    "session": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
    },
    "reason": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/claimReleaseReason"
    }
  },
  "required": [
    "type",
    "session",
    "reason"
  ],
  "unevaluatedProperties": false
}
