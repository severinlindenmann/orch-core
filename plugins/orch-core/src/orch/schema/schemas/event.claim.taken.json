{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.claim.taken",
  "title": "claim.taken event",
  "description": "5.4.1. Agents only (with a grant).",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorAgent"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "claim.taken"
    },
    "takeover": {
      "type": "object",
      "properties": {
        "from_session": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
        },
        "reason": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
        }
      },
      "additionalProperties": false,
      "required": [
        "from_session",
        "reason"
      ]
    }
  },
  "required": [
    "type"
  ],
  "unevaluatedProperties": false
}
