{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.claim.taken",
  "title": "claim.taken event",
  "description": "T7: a claim; takeover is logged.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "not": {
        "required": [
          "sig"
        ]
      }
    }
  ],
  "properties": {
    "type": {
      "const": "claim.taken"
    },
    "for": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
    },
    "expires_at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "takeover": {
      "type": "object",
      "properties": {
        "from_session": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
        },
        "reason": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
        }
      },
      "additionalProperties": false,
      "required": [
        "from_session",
        "reason"
      ]
    }
  },
  "required": [
    "type",
    "for",
    "expires_at"
  ],
  "unevaluatedProperties": false
}
