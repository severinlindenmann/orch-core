{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.device.added",
  "title": "device.added event",
  "description": "5.4.2, 5.3. A drop: certificate is refused.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorP"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "device.added"
    },
    "device": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/deviceId"
    },
    "cert": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/deviceCertDecide"
    }
  },
  "required": [
    "type",
    "device",
    "cert"
  ],
  "unevaluatedProperties": false
}
