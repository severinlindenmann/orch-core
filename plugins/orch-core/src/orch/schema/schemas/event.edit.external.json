{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.edit.external",
  "title": "edit.external event",
  "description": "T9/section 5: unsigned, unattributed file edit.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event-host"
    },
    {
      "not": {
        "required": [
          "sig"
        ]
      }
    },
    {
      "not": {
        "required": [
          "actor"
        ]
      }
    }
  ],
  "properties": {
    "type": {
      "const": "edit.external"
    },
    "files": {
      "type": "array",
      "items": {
        "enum": [
          "ticket.json",
          "body.md"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sectionId"
      },
      "uniqueItems": true
    },
    "voided_gates": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "type",
    "files"
  ],
  "unevaluatedProperties": false
}
