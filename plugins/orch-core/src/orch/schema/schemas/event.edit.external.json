{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.edit.external",
  "title": "edit.external event",
  "description": "5.4.1, 5.8. voided_gates and normalised are derived.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorH"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "edit.external"
    },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/anySectionId"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "hash": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
              },
              "refs": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "required": [
              "hash",
              "refs"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "voided_gates": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
      },
      "uniqueItems": true
    },
    "normalised": {
      "type": "boolean"
    }
  },
  "required": [
    "type",
    "sections",
    "voided_gates",
    "normalised"
  ],
  "unevaluatedProperties": false
}
