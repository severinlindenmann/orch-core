{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.gate.changes_requested",
  "title": "gate.changes_requested event",
  "description": "Section 5: change requests are signed. Event name not given in the doc.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "required": [
        "sig",
        "presence"
      ],
      "properties": {
        "actor": {
          "properties": {
            "kind": {
              "const": "person"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "gate.changes_requested"
    },
    "hash": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "gate": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
    },
    "text": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
    },
    "list_seq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "type",
    "gate",
    "hash"
  ],
  "unevaluatedProperties": false
}
