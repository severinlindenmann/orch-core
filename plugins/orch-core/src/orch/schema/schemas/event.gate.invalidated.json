{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.gate.invalidated",
  "title": "gate.invalidated event",
  "description": "5.4.1, D58. A record only; voided is derived (5.11).",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorH"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "gate.invalidated"
    },
    "gate": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/gateName"
    },
    "cause": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/invalidatedCause"
    },
    "voided": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "type",
    "gate",
    "cause",
    "voided"
  ],
  "unevaluatedProperties": false
}
