{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event",
  "title": "Event envelope",
  "description": "Format doc section 5.1. Every event has an actor; person events (and only those) carry sig, auth and roster_v; prev/based_on are null only on seq 1; ws_seq is for ticket-log events (validate(log=) enforces it). This schema is the envelope alone; each event.<type> schema repeats it (inlined for speed) with the payload and the actor rule of its row. validate('event', obj, log=) dispatches on type; a type outside section 5.4 is refused in P1.",
  "$defs": {
    "actor": {
      "type": "object",
      "description": "Section 5.2. A person, an agent (with a grant, or unattended) or the host. An addon actor is refused in P1 (A5).",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "person",
            "agent",
            "host"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "person"
              },
              "id": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
              },
              "device": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/deviceId"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "device"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "agent"
                  },
                  "id": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                  },
                  "session": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                  },
                  "for": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                  },
                  "grant": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/grantId"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "session",
                  "for",
                  "grant"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "agent"
                  },
                  "id": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                  },
                  "session": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                  },
                  "unattended": {
                    "const": true
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "session",
                  "unattended"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "host"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "host"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind"
            ]
          }
        }
      ]
    },
    "actorP": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "person"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "actorA": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "agent"
          ]
        },
        "unattended": false
      },
      "required": [
        "kind"
      ]
    },
    "actorU": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "agent"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "actorAgent": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "agent"
          ]
        },
        "unattended": false
      },
      "required": [
        "kind"
      ]
    },
    "actorH": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "host"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "actorPH": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "host"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "actorAH": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "agent",
            "host"
          ]
        },
        "unattended": false
      },
      "required": [
        "kind"
      ]
    }
  },
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "id": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
    },
    "seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "type": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/eventType"
    },
    "actor": {
      "type": "object",
      "description": "Section 5.2. A person, an agent (with a grant, or unattended) or the host. An addon actor is refused in P1 (A5).",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "person",
            "agent",
            "host"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "person"
              },
              "id": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
              },
              "device": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/deviceId"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "device"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "agent"
                  },
                  "id": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                  },
                  "session": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                  },
                  "for": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                  },
                  "grant": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/grantId"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "session",
                  "for",
                  "grant"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "agent"
                  },
                  "id": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                  },
                  "session": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                  },
                  "unattended": {
                    "const": true
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "session",
                  "unattended"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "host"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "host"
              }
            },
            "additionalProperties": false,
            "required": [
              "kind"
            ]
          }
        }
      ]
    },
    "based_on": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "prev": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash_v": {
      "const": 1
    },
    "ws_seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "roster_v": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "auth": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/auth"
    },
    "sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "host_sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    }
  },
  "required": [
    "v",
    "id",
    "seq",
    "at",
    "type",
    "actor",
    "based_on",
    "prev",
    "hash_v",
    "host_sig"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "required": [
          "sig",
          "auth",
          "roster_v"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "host"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "sig": {
            "not": {}
          },
          "auth": {
            "not": {}
          },
          "roster_v": {
            "not": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seq": {
            "const": 1
          }
        },
        "required": [
          "seq"
        ]
      },
      "then": {
        "properties": {
          "prev": {
            "type": "null"
          },
          "based_on": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "prev": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          },
          "based_on": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          }
        }
      }
    }
  ]
}
