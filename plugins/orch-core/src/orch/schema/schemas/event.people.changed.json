{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.people.changed",
  "title": "people.changed event",
  "description": "T4/section 5: changes to people are signed.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "anyOf": [
        {
          "required": [
            "add"
          ]
        },
        {
          "required": [
            "remove"
          ]
        }
      ]
    },
    {
      "required": [
        "sig",
        "presence"
      ],
      "properties": {
        "actor": {
          "properties": {
            "kind": {
              "const": "person"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "people.changed"
    },
    "role": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ticketRole"
    },
    "add": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
      },
      "uniqueItems": true
    },
    "remove": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
      },
      "uniqueItems": true
    },
    "list_seq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "type",
    "role"
  ],
  "unevaluatedProperties": false
}
