{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.people.changed",
  "title": "people.changed event",
  "description": "5.4.1. For role owner, add has exactly one id.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorP"
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "owner"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "add": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "people.changed"
    },
    "role": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ticketPeopleRole"
    },
    "add": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
      },
      "uniqueItems": true
    },
    "remove": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "type",
    "role",
    "add",
    "remove"
  ],
  "unevaluatedProperties": false
}
