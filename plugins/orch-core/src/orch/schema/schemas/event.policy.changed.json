{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.policy.changed",
  "title": "policy.changed event",
  "description": "5.4.1 (override) and 5.4.2 (workspace default); both logs.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorP"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "policy.changed"
    },
    "gates": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatesPartial"
    }
  },
  "required": [
    "type",
    "gates"
  ],
  "unevaluatedProperties": false
}
