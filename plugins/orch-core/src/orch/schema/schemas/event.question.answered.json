{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.question.answered",
  "title": "question.answered event",
  "description": "5.4.1. At least one of option, text. In P1 an answer with evidence is refused (it is an extra field).",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "id": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
    },
    "seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "type": {
      "const": "question.answered"
    },
    "actor": {
      "allOf": [
        {
          "type": "object",
          "description": "Section 5.2. A person, an agent (with a grant, or unattended) or the host. An addon actor is refused in P1 (A5).",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "person",
                "agent",
                "host"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "person"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "if": {
                  "required": [
                    "via"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "person"
                    },
                    "id": {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hubUserId"
                    },
                    "via": {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "via"
                  ]
                },
                "else": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "person"
                    },
                    "id": {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                    },
                    "device": {
                      "$ref": "https://schemas.orch.dev/v2/common#/$defs/deviceId"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "device"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "agent"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "for": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                      },
                      "grant": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/grantId"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "for",
                      "grant"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "unattended": {
                        "const": true
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "unattended"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "person"
              ]
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "based_on": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "prev": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash_v": {
      "const": 1
    },
    "ws_seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "roster_v": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "auth": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/auth"
    },
    "sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "host_sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "question": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/questionId"
    },
    "hash": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "option": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
    },
    "text": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
    },
    "channel": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
    },
    "channel_factor": {
      "enum": [
        "password+totp",
        "se-unlocked",
        "passkey"
      ]
    },
    "hub_id": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
    },
    "snapshot_version": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "channel_cert": {
      "type": "object",
      "properties": {
        "o": {
          "type": "object"
        },
        "sig": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
        }
      },
      "additionalProperties": false,
      "required": [
        "o",
        "sig"
      ]
    },
    "uk_cert": {
      "type": "object",
      "properties": {
        "o": {
          "type": "object"
        },
        "sig": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
        }
      },
      "additionalProperties": false,
      "required": [
        "o",
        "sig"
      ]
    },
    "item_hash": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "channel_proof": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    }
  },
  "required": [
    "v",
    "id",
    "seq",
    "at",
    "type",
    "actor",
    "based_on",
    "prev",
    "hash_v",
    "host_sig",
    "question",
    "hash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "required": [
          "sig",
          "auth",
          "roster_v"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "host"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "sig": {
            "not": {}
          },
          "auth": {
            "not": {}
          },
          "roster_v": {
            "not": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seq": {
            "const": 1
          }
        },
        "required": [
          "seq"
        ]
      },
      "then": {
        "properties": {
          "prev": {
            "type": "null"
          },
          "based_on": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "prev": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          },
          "based_on": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          }
        }
      }
    },
    {
      "anyOf": [
        {
          "required": [
            "option"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "auth": {
            "const": "hub"
          }
        },
        "required": [
          "auth"
        ]
      },
      "then": {
        "required": [
          "channel",
          "channel_factor",
          "hub_id",
          "snapshot_version",
          "channel_cert",
          "uk_cert",
          "channel_proof"
        ],
        "properties": {
          "actor": {
            "required": [
              "via"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "channel": {
            "not": {}
          },
          "channel_factor": {
            "not": {}
          },
          "hub_id": {
            "not": {}
          },
          "snapshot_version": {
            "not": {}
          },
          "channel_cert": {
            "not": {}
          },
          "uk_cert": {
            "not": {}
          },
          "channel_proof": {
            "not": {}
          },
          "item_hash": {
            "not": {}
          },
          "actor": {
            "not": {
              "required": [
                "via"
              ]
            }
          }
        }
      }
    }
  ]
}
