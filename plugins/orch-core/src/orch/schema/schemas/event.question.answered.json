{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.question.answered",
  "title": "question.answered event",
  "description": "T6: the first valid signed answer for the current hash wins.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "required": [
        "sig",
        "presence"
      ],
      "properties": {
        "actor": {
          "properties": {
            "kind": {
              "const": "person"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "question.answered"
    },
    "question": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/questionId"
    },
    "hash": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "answer": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
    },
    "list_seq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "type",
    "question",
    "hash",
    "answer"
  ],
  "unevaluatedProperties": false
}
