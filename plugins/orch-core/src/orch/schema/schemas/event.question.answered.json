{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.question.answered",
  "title": "question.answered event",
  "description": "5.4.1. At least one of option, text. In P1 an answer with evidence is refused (it is an extra field).",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorP"
        }
      }
    },
    {
      "anyOf": [
        {
          "required": [
            "option"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ]
    }
  ],
  "properties": {
    "type": {
      "const": "question.answered"
    },
    "question": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/questionId"
    },
    "hash": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "option": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/token"
    },
    "text": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
    }
  },
  "required": [
    "type",
    "question",
    "hash"
  ],
  "unevaluatedProperties": false
}
