{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.question.asked",
  "title": "question.asked event",
  "description": "T6/A5: ask (unattended allowed); the question text lives in ticket.json.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "not": {
        "required": [
          "sig"
        ]
      }
    }
  ],
  "properties": {
    "type": {
      "const": "question.asked"
    },
    "question": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/questionId"
    }
  },
  "required": [
    "type",
    "question"
  ],
  "unevaluatedProperties": false
}
