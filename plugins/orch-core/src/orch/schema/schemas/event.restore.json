{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.restore",
  "title": "restore event",
  "description": "5.4.1, 5.10. Both logs, owner only. Appended as from_seq + 1 with prev = head (validate()).",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorP"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "restore"
    },
    "from_seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "head": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "abandoned": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "seq": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
            },
            "head": {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
            }
          },
          "additionalProperties": false,
          "required": [
            "seq",
            "head"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "abandoned_decisions": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
      },
      "uniqueItems": true
    },
    "reason": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
    }
  },
  "required": [
    "type",
    "from_seq",
    "head",
    "abandoned",
    "abandoned_decisions",
    "reason"
  ],
  "unevaluatedProperties": false
}
