{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.session.granted",
  "title": "session.granted event",
  "description": "T7/A3: session grants are signed by the person.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "required": [
        "sig",
        "presence"
      ],
      "properties": {
        "actor": {
          "properties": {
            "kind": {
              "const": "person"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "session.granted"
    },
    "grant": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/grantId"
    },
    "for": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
    },
    "session": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
    },
    "expires_at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    }
  },
  "required": [
    "type",
    "grant",
    "for",
    "expires_at"
  ],
  "unevaluatedProperties": false
}
