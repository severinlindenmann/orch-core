{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.settings.changed",
  "title": "settings.changed event",
  "description": "5.4.2, D60. A null repo removes it.",
  "type": "object",
  "properties": {
    "v": {
      "const": 2
    },
    "id": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
    },
    "seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "at": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/timestamp"
    },
    "type": {
      "const": "settings.changed"
    },
    "actor": {
      "allOf": [
        {
          "type": "object",
          "description": "Section 5.2. A person, an agent (with a grant, or unattended) or the host. An addon actor is refused in P1 (A5).",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "person",
                "agent",
                "host"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "person"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "person"
                  },
                  "id": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                  },
                  "device": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/deviceId"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "device"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "agent"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "for": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
                      },
                      "grant": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/grantId"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "for",
                      "grant"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "agent"
                      },
                      "id": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/agentId"
                      },
                      "session": {
                        "$ref": "https://schemas.orch.dev/v2/common#/$defs/sessionId"
                      },
                      "unattended": {
                        "const": true
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "id",
                      "session",
                      "unattended"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "host"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "kind"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "person"
              ]
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "based_on": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "prev": {
      "oneOf": [
        {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash_v": {
      "const": 1
    },
    "ws_seq": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/posInt"
    },
    "roster_v": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "auth": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/auth"
    },
    "sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "host_sig": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sig"
    },
    "set": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "grant_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "claim_ttl_min": {
          "type": "integer",
          "minimum": 15,
          "maximum": 1440
        },
        "lease_ttl_min": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "sign_methods": {
          "type": "array",
          "description": "B6 (owner decision F, 16 Oct 2026): the ways a signature may be made in this workspace. terminal is always present; touchid is reserved and not selectable yet.",
          "items": {
            "enum": [
              "terminal",
              "click",
              "phone",
              "hub"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 4,
          "contains": {
            "const": "terminal"
          }
        },
        "repos": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/repoName"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
                  },
                  "remote": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/repoIdentity"
                  },
                  "default_branch": {
                    "$ref": "https://schemas.orch.dev/v2/common#/$defs/branchName"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "path"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "publish": {
          "oneOf": [
            {
              "type": "object",
              "description": "The Publish add-on's server: where shared files go (api, signed requests) and where a link opens (share). A person signs it; it is never an agent's choice. null removes it.",
              "properties": {
                "server": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/publishOrigin"
                },
                "share": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/publishOrigin"
                }
              },
              "required": [
                "server",
                "share"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "models": {
          "oneOf": [
            {
              "type": "object",
              "description": "Model routing: for each harness and Start agent mode, the model a start uses; a mode that is not named uses the harness default. Names come from a closed list per harness. null clears every choice.",
              "properties": {
                "claude-code": {
                  "type": "object",
                  "properties": {
                    "work": {
                      "enum": [
                        "fable",
                        "opus",
                        "sonnet",
                        "haiku"
                      ]
                    },
                    "refine": {
                      "enum": [
                        "fable",
                        "opus",
                        "sonnet",
                        "haiku"
                      ]
                    },
                    "fix": {
                      "enum": [
                        "fable",
                        "opus",
                        "sonnet",
                        "haiku"
                      ]
                    },
                    "continue": {
                      "enum": [
                        "fable",
                        "opus",
                        "sonnet",
                        "haiku"
                      ]
                    },
                    "context": {
                      "enum": [
                        "fable",
                        "opus",
                        "sonnet",
                        "haiku"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "codex": {
                  "type": "object",
                  "properties": {
                    "work": {
                      "enum": [
                        "gpt-5.4",
                        "gpt-5-codex",
                        "gpt-5",
                        "o3"
                      ]
                    },
                    "refine": {
                      "enum": [
                        "gpt-5.4",
                        "gpt-5-codex",
                        "gpt-5",
                        "o3"
                      ]
                    },
                    "fix": {
                      "enum": [
                        "gpt-5.4",
                        "gpt-5-codex",
                        "gpt-5",
                        "o3"
                      ]
                    },
                    "continue": {
                      "enum": [
                        "gpt-5.4",
                        "gpt-5-codex",
                        "gpt-5",
                        "o3"
                      ]
                    },
                    "context": {
                      "enum": [
                        "gpt-5.4",
                        "gpt-5-codex",
                        "gpt-5",
                        "o3"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "minProperties": 1,
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "seq",
    "at",
    "type",
    "actor",
    "based_on",
    "prev",
    "hash_v",
    "host_sig",
    "set"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "person"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "required": [
          "sig",
          "auth",
          "roster_v"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "enum": [
                  "agent",
                  "host"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "sig": {
            "not": {}
          },
          "auth": {
            "not": {}
          },
          "roster_v": {
            "not": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "seq": {
            "const": 1
          }
        },
        "required": [
          "seq"
        ]
      },
      "then": {
        "properties": {
          "prev": {
            "type": "null"
          },
          "based_on": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "prev": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          },
          "based_on": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
          }
        }
      }
    }
  ]
}
