{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.status.changed",
  "title": "status.changed event",
  "description": "5.4.1, 5.9. Manual moves only: to is backlog or open; which from-states are allowed is the status rule of 5.9.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorA"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "status.changed"
    },
    "from": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/status"
    },
    "to": {
      "enum": [
        "backlog",
        "open"
      ]
    },
    "reason": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
    }
  },
  "required": [
    "type",
    "from",
    "to"
  ],
  "unevaluatedProperties": false
}
