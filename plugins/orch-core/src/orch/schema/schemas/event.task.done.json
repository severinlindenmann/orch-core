{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.task.done",
  "title": "task.done event",
  "description": "5.4.1. receipt.cmd must equal the task's verify.cmd (host).",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorA"
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "task.done"
    },
    "task": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/taskId"
    },
    "receipt": {
      "type": "object",
      "properties": {
        "cmd": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
        },
        "exit": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/safeInt"
        },
        "ms": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
        },
        "repo": {
          "oneOf": [
            {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/repoName"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit": {
          "oneOf": [
            {
              "$ref": "https://schemas.orch.dev/v2/common#/$defs/gitCommit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "cmd",
        "exit",
        "ms",
        "repo",
        "commit"
      ]
    },
    "log": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
    },
    "text": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
    }
  },
  "required": [
    "type",
    "task"
  ],
  "unevaluatedProperties": false
}
