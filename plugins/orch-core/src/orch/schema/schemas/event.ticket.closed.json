{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.ticket.closed",
  "title": "ticket.closed event",
  "description": "5.4.1. duplicate_of only with resolution duplicate.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorP"
        }
      }
    },
    {
      "if": {
        "properties": {
          "duplicate_of": {}
        },
        "required": [
          "duplicate_of"
        ]
      },
      "then": {
        "properties": {
          "resolution": {
            "const": "duplicate"
          }
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "ticket.closed"
    },
    "resolution": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/closeResolution"
    },
    "duplicate_of": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ticketKey"
    },
    "text": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
    }
  },
  "required": [
    "type",
    "resolution"
  ],
  "unevaluatedProperties": false
}
