{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.ticket.reopened",
  "title": "ticket.reopened event",
  "description": "Section 5: reopen is a signed human event.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "required": [
        "sig",
        "presence"
      ],
      "properties": {
        "actor": {
          "properties": {
            "kind": {
              "const": "person"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "type": {
      "const": "ticket.reopened"
    },
    "reason": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
    }
  },
  "required": [
    "type"
  ],
  "unevaluatedProperties": false
}
