{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.ticket.updated",
  "title": "ticket.updated event",
  "description": "5.4.1, 5.8. Leaf paths only; protected paths (schema, uid, key, visibility, questions) can not be set. At least one of set, sections; base_rev names exactly the touched paths and values of core paths are checked against ticket.json (validate()).",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorA"
        }
      }
    },
    {
      "anyOf": [
        {
          "required": [
            "set"
          ]
        },
        {
          "required": [
            "sections"
          ]
        }
      ]
    }
  ],
  "properties": {
    "type": {
      "const": "ticket.updated"
    },
    "base_rev": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:ticket\\.(?:title|type|priority|size|labels|parent|blocked_by|due|links|acceptance|tasks)|ticket\\.addons\\.[a-z][a-z0-9-]{0,39}\\.[a-z][a-z0-9_]*|body\\.(?:summary|context|requirements|out_of_scope|plan|decisions|verification|findings|current_state|[a-z][a-z0-9-]{0,39}\\.[a-z][a-z0-9_]*))(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
      }
    },
    "set": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:ticket\\.(?:title|type|priority|size|labels|parent|blocked_by|due|links|acceptance|tasks)|ticket\\.addons\\.[a-z][a-z0-9-]{0,39}\\.[a-z][a-z0-9_]*)(?![\\s\\S])"
      }
    },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/anySectionId"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "hash": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
              },
              "refs": {
                "type": "array",
                "items": {
                  "$ref": "https://schemas.orch.dev/v2/common#/$defs/artifactName"
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false,
            "required": [
              "hash",
              "refs"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": [
    "type",
    "base_rev"
  ],
  "unevaluatedProperties": false
}
