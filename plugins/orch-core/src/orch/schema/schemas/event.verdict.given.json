{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/event.verdict.given",
  "title": "verdict.given event",
  "description": "5.4.1. The verify gate's decision (D58). text is required on fail.",
  "allOf": [
    {
      "$ref": "https://schemas.orch.dev/v2/event"
    },
    {
      "properties": {
        "actor": {
          "$ref": "https://schemas.orch.dev/v2/event#/$defs/actorP"
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "fail"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "text"
        ]
      }
    }
  ],
  "properties": {
    "type": {
      "const": "verdict.given"
    },
    "outcome": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/verdictOutcome"
    },
    "gate_gen": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/nonNegInt"
    },
    "hash": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "policy_hash": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/hash"
    },
    "source_sha": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/sourceList"
    },
    "text": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
    }
  },
  "required": [
    "type",
    "outcome",
    "gate_gen",
    "hash",
    "policy_hash",
    "source_sha"
  ],
  "unevaluatedProperties": false
}
