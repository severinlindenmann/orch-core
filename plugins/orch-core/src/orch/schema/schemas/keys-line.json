{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/keys-line",
  "title": "keys.jsonl line",
  "description": "Format doc T1/T2 and section 2: keys.jsonl maps a key to a uid, append-only.",
  "type": "object",
  "properties": {
    "key": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ticketKey"
    },
    "uid": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/ulid"
    }
  },
  "additionalProperties": false,
  "required": [
    "key",
    "uid"
  ]
}
