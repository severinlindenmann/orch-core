{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/operation",
  "title": "Operation declaration",
  "description": "Core section 3: the registry fields of one operation (not the operations themselves). 'who: human' operations must emit a signed event type.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "input": {
      "allOf": [
        {
          "$ref": "https://json-schema.org/draft/2020-12/schema"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "object"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "who": {
      "enum": [
        "agent",
        "unattended",
        "human",
        "read"
      ]
    },
    "pre": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
      }
    },
    "emits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
      },
      "uniqueItems": true
    },
    "output": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^ok [^\\n]*(\\nnext: [^\\n]*)?$"
        },
        "json": {
          "$ref": "https://json-schema.org/draft/2020-12/schema"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "json"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "hint": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/text"
          },
          "fix": {
            "type": "object",
            "properties": {
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "argv"
            ]
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "code",
          "hint",
          "fix"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "input",
    "who",
    "pre",
    "emits",
    "output",
    "errors"
  ]
}
