{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/workspace",
  "title": "Workspace config.json",
  "description": "Format doc section 2 (config.json), T5, T8, D59, D60. Mirrors the signed workspace log; persons are unique (validate()).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "orch.workspace/2"
    },
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hex32"
        },
        "prefix": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/prefix"
        },
        "name": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "prefix",
        "name"
      ]
    },
    "host": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hostId"
        },
        "wsk_pub": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/pubkey"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "wsk_pub"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "person": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
          },
          "name": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/line"
          },
          "role": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/memberRole"
          }
        },
        "additionalProperties": false,
        "required": [
          "person",
          "name",
          "role"
        ]
      },
      "minItems": 1
    },
    "gates": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/gatesAll"
    },
    "settings": {
      "type": "object",
      "properties": {
        "grant_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "claim_ttl_min": {
          "type": "integer",
          "minimum": 15,
          "maximum": 1440
        },
        "lease_ttl_min": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "repos": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/repoName"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "https://schemas.orch.dev/v2/common#/$defs/str"
              }
            },
            "additionalProperties": false,
            "required": [
              "path"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "grant_hours",
        "claim_ttl_min",
        "lease_ttl_min",
        "repos"
      ]
    },
    "agents": {
      "type": "object",
      "properties": {
        "run_for": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/memberRole"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "run_for"
      ]
    },
    "addons": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "enabled"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace",
    "host",
    "members",
    "gates",
    "settings",
    "agents",
    "addons"
  ]
}
