{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orch.dev/v2/workspace",
  "title": "Workspace config.json",
  "description": "Format doc section 2 (config.json excerpt) and T5, T8.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "orch.workspace/2"
    },
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/uuid"
        },
        "prefix": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/prefix"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "prefix",
        "name"
      ]
    },
    "host": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/hostId"
        },
        "wsk_pub": {
          "$ref": "https://schemas.orch.dev/v2/common#/$defs/pubkey"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "wsk_pub"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "person": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/personId"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/memberRole"
          }
        },
        "additionalProperties": false,
        "required": [
          "person",
          "name",
          "role"
        ]
      },
      "minItems": 1
    },
    "gates": {
      "$ref": "https://schemas.orch.dev/v2/common#/$defs/gates"
    },
    "agents": {
      "type": "object",
      "properties": {
        "run_for": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.orch.dev/v2/common#/$defs/memberRole"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "run_for"
      ]
    },
    "addons": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://schemas.orch.dev/v2/common#/$defs/addonName"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "enabled"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace",
    "host",
    "members",
    "gates",
    "agents",
    "addons"
  ]
}
