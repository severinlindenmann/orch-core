{
  "name": "agent-waterfall",
  "title": "Agent waterfall",
  "description": "An agent run's tool calls as a waterfall: one row per call with start, duration and outcome; a row opens to its input and result.",
  "moment": "debug",
  "libs": [],
  "min_height": 200,
  "versions": {
    "1": {
      "notes": "start and duration share the unit (s or ms), start measured from the beginning of the run. Summaries are short excerpts, never whole payloads or secrets.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["calls"],
        "properties": {
          "unit": {"enum": ["s", "ms"]},
          "calls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "start", "duration", "ok"],
              "properties": {
                "name": {"type": "string", "minLength": 1, "maxLength": 200},
                "start": {"type": "number", "minimum": 0},
                "duration": {"type": "number", "minimum": 0},
                "ok": {"type": "boolean"},
                "input": {"type": "string", "maxLength": 2000},
                "result": {"type": "string", "maxLength": 2000},
                "note": {"type": "string", "maxLength": 500}
              }
            }
          }
        }
      }
    }
  }
}
