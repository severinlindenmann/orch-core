{
  "name": "bundle-treemap",
  "title": "Bundle treemap",
  "description": "Bundle files as a squarified treemap sized by their size on the branch, coloured and labelled by growth against the base.",
  "moment": "review",
  "libs": [],
  "min_height": 300,
  "versions": {
    "1": {
      "notes": "base and head are sizes in unit; a new file has base 0, a removed file head 0 (drawn at its base size, marked removed).",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["files"],
        "properties": {
          "unit": {"enum": ["B", "kB", "MB"]},
          "base_label": {"type": "string", "maxLength": 200},
          "head_label": {"type": "string", "maxLength": 200},
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "base", "head"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 500},
                "base": {"type": "number", "minimum": 0},
                "head": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
