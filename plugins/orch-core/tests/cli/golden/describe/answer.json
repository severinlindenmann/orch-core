{
  "v": "orch.cli/2.0",
  "ok": true,
  "data": {
    "target": "answer",
    "name": "answer",
    "cli": "orch answer",
    "summary": "Answer a question with an option, text, or both.",
    "who": "human",
    "usage": "orch answer Q [--option KEY] [--message TEXT] [--ref REF] [--dry-run]",
    "pre": [
      "ticket_exists",
      "question_open",
      "role_allows",
      "user_presence",
      "text_clean"
    ],
    "emits": [
      "question.answered"
    ],
    "input": {
      "type": "object",
      "description": "Answer a question with an option, text, or both.",
      "properties": {
        "question": {
          "type": "string",
          "description": "question id",
          "pattern": "^Q[1-9][0-9]*$",
          "x-metavar": "Q"
        },
        "option": {
          "type": "string",
          "description": "option key",
          "x-metavar": "KEY"
        },
        "message": {
          "type": "string",
          "description": "free text",
          "x-short": "m",
          "x-metavar": "TEXT"
        },
        "ref": {
          "type": "string",
          "description": "ticket REF (flag)",
          "pattern": "^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+(?:/T[1-9][0-9]*)?|T[1-9][0-9]*)$",
          "x-metavar": "REF"
        }
      },
      "x-positional": [
        "question"
      ],
      "required": [
        "question"
      ],
      "additionalProperties": false
    },
    "output": {
      "text": "ok {key} question.answered {question} seq={seq}\nnext: {next}",
      "json": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "additionalProperties": false
      }
    },
    "errors": [
