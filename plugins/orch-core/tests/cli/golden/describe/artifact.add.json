{
  "v": "orch.cli/2.0",
  "ok": true,
  "data": {
    "target": "artifact.add",
    "name": "artifact.add",
    "cli": "orch artifact add",
    "summary": "Store a file; works without a grant (unattended, never evidence). --ac and --task need a grant.",
    "who": "unattended",
    "usage": "orch artifact add PATH [--ref REF] [--kind KIND] [--name NAME] [--ac AC] [--task TASK] [--label TEXT] [--dry-run]",
    "pre": [
      "ticket_exists",
      "ticket_visible",
      "ticket_open_for_work",
      "unattended_scope",
      "unattended_quota",
      "text_clean"
    ],
    "emits": [
      "artifact.added"
    ],
    "input": {
      "type": "object",
      "description": "Store a file; works without a grant (unattended, never evidence). --ac and --task need a grant.",
      "properties": {
        "path": {
          "type": "string",
          "description": "file to store",
          "x-metavar": "PATH"
        },
        "ref": {
          "type": "string",
          "description": "ticket REF (flag); default: your claim",
          "pattern": "^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+(?:/T[1-9][0-9]*)?|T[1-9][0-9]*)$",
          "x-metavar": "REF"
        },
        "kind": {
          "type": "string",
          "enum": [
            "screenshot",
            "log",
            "report",
            "link",
            "dataset",
            "build",
            "diagram",
            "receipt",
            "other"
          ],
          "description": "what it is",
          "default": "other"
        },
        "name": {
          "type": "string",
          "description": "name in the ticket; default: the file name",
          "x-metavar": "NAME"
        },
        "ac": {
          "type": "string",
          "description": "criterion it is evidence for (needs a grant)",
          "pattern": "^AC[1-9][0-9]*$",
          "x-metavar": "AC",
          "x-needs-grant": true
        },
        "task": {
          "type": "string",
          "description": "task it belongs to (needs a grant)",
          "pattern": "^T[1-9][0-9]*$",
          "x-metavar": "TASK",
          "x-needs-grant": true
        },
        "label": {
          "type": "string",
          "description": "short label",
          "x-metavar": "TEXT"
        }
      },
      "x-positional": [
        "path"
      ],
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "output": {
      "text": "ok {key} artifact.added {name} seq={seq}\nnext: {next}",
      "json": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "errors": [
      {
        "code": "ambiguous_ref",
        "exit": 2,
        "retryable": false,
        "hint": "name the ticket REF, for example DEMO-0043",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "not_found",
        "exit": 2,
        "retryable": false,
        "hint": "orch list",
        "fix": [
          "orch",
          "list"
        ]
      },
      {
        "code": "grant.expired",
        "exit": 3,
        "retryable": false,
        "hint": "ask the person for a new grant",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "grant.required",
        "exit": 3,
        "retryable": false,
        "hint": "ask the person to run orch grant, then set ORCH_GRANT",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "transition.refused",
        "exit": 3,
        "retryable": false,
        "hint": "orch show --section current_state",
        "fix": [
          "orch",
          "show"
        ]
      },
      {
        "code": "lock.busy",
        "exit": 4,
        "retryable": true,
        "hint": "retry in a moment",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "quota.unattended",
        "exit": 9,
        "retryable": true,
        "hint": "ask the person for a grant",
        "fix": [
          "orch",
          "status"
        ]
      }
    ]
  },
  "key": null,
  "seq": 0,
  "cursor": 0,
  "hints": []
}
