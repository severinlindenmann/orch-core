{"v":"orch.cli/2.0","ok":true,"data":{"target":"handoff","name":"handoff","cli":"orch handoff","summary":"Write the current state (at most 2048 bytes) and release the claim.","who":"agent","usage":"orch handoff [REF] [--message TEXT] [--file PATH] [--dry-run]","pre":["ticket_exists","session_holds_claim","grant_valid","text_clean"],"emits":["handoff.written","claim.released"],"input":{"type":"object","description":"Write the current state (at most 2048 bytes) and release the claim.","properties":{"ref":{"type":"string","description":"ticket REF (DEMO-0043, 43); default: your claim","pattern":"^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+(?:/T[1-9][0-9]*)?|T[1-9][0-9]*)$","x-metavar":"REF"},"message":{"type":"string","description":"free text","x-short":"m","x-metavar":"TEXT"},"file":{"type":"string","description":"read the text from PATH, or - for stdin","x-metavar":"PATH"}},"x-positional":["ref"],"required":[],"additionalProperties":false},"output":{"text":"ok {key} handoff.written {bytes} seq={seq}\nnext: {next}","json":{"type":"object","properties":{"bytes":{"type":"integer","minimum":0}},"required":["bytes"],"additionalProperties":false}},"errors":[{"code":"ambiguous_ref","exit":2,"retryable":false,"hint":"name the ticket REF, for example DEMO-0043","fix":["orch","status"]},{"code":"not_found","exit":2,"retryable":false,"hint":"orch list","fix":["orch","list"]},{"code":"grant.expired","exit":3,"retryable":false,"hint":"ask the person for a new grant","fix":["orch","status"]},{"code":"grant.required","exit":3,"retryable":false,"hint":"ask the person to run orch grant, then set ORCH_GRANT","fix":["orch","status"]},{"code":"claim.required","exit":4,"retryable":false,"hint":"orch claim","fix":["orch","claim"]},{"code":"lock.busy","exit":4,"retryable":true,"hint":"retry in a moment","fix":["orch","status"]},{"code":"parse.text","exit":6,"retryable":false,"hint":"orch describe handoff","fix":["orch","describe","handoff"]}]},"key":null,"seq":0,"cursor":0,"hints":[]}
