{
  "v": "orch.cli/2.0",
  "ok": true,
  "data": {
    "target": "log",
    "name": "log",
    "cli": "orch log",
    "summary": "Add a note to the ticket log; works without a grant (unattended).",
    "who": "unattended",
    "usage": "orch log [TEXT] [--message TEXT] [--file PATH] [--ref REF] [--dry-run]",
    "pre": [
      "ticket_exists",
      "ticket_visible",
      "unattended_scope",
      "text_clean",
      "unattended_quota"
    ],
    "emits": [
      "log.added"
    ],
    "input": {
      "type": "object",
      "description": "Add a note to the ticket log; works without a grant (unattended).",
      "properties": {
        "text": {
          "type": "string",
          "description": "the note, at most 4096 bytes",
          "x-metavar": "TEXT"
        },
        "message": {
          "type": "string",
          "description": "free text",
          "x-short": "m",
          "x-metavar": "TEXT"
        },
        "file": {
          "type": "string",
          "description": "read the text from PATH, or - for stdin",
          "x-metavar": "PATH"
        },
        "ref": {
          "type": "string",
          "description": "ticket REF (flag); default: your claim",
          "pattern": "^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+(?:/T[1-9][0-9]*)?|T[1-9][0-9]*)$",
          "x-metavar": "REF"
        }
      },
      "x-positional": [
        "text"
      ],
      "required": [],
      "oneOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "message"
          ]
        },
        {
          "required": [
            "file"
          ]
        }
      ],
      "additionalProperties": false
    },
    "output": {
      "text": "ok {key} log.added seq={seq}\nnext: {next}",
      "json": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    "errors": [
      {
        "code": "ambiguous_ref",
        "exit": 2,
        "retryable": false,
        "hint": "name the ticket REF, for example DEMO-0043",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "not_found",
        "exit": 2,
        "retryable": false,
        "hint": "orch list",
        "fix": [
          "orch",
          "list"
        ]
      },
      {
        "code": "grant.expired",
        "exit": 3,
        "retryable": false,
        "hint": "ask the person for a new grant",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "grant.required",
        "exit": 3,
        "retryable": false,
        "hint": "ask the person to run orch grant, then set ORCH_GRANT",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "lock.busy",
        "exit": 4,
        "retryable": true,
        "hint": "retry in a moment",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "parse.text",
        "exit": 6,
        "retryable": false,
        "hint": "orch describe log",
        "fix": [
          "orch",
          "describe",
          "log"
        ]
      },
      {
        "code": "quota.unattended",
        "exit": 9,
        "retryable": true,
        "hint": "ask the person for a grant",
        "fix": [
          "orch",
          "status"
        ]
      }
    ]
  },
  "key": null,
  "seq": 0,
  "cursor": 0,
  "hints": []
}
