{
  "v": "orch.cli/2.0",
  "ok": true,
  "data": {
    "target": "task.add",
    "name": "task.add",
    "cli": "orch task add",
    "summary": "Add a task, optionally with a verify command and the criteria it proves.",
    "who": "agent",
    "usage": "orch task add TEXT [--verify CMD] [--proves AC1,AC2] [--assignee PERSON] [--ref REF] [--dry-run]",
    "pre": [
      "ticket_exists",
      "ticket_open_for_work",
      "acceptance_exists",
      "base_rev_tracked",
      "grant_valid",
      "text_clean"
    ],
    "emits": [
      "ticket.updated"
    ],
    "input": {
      "type": "object",
      "description": "Add a task, optionally with a verify command and the criteria it proves.",
      "properties": {
        "text": {
          "type": "string",
          "description": "the task",
          "x-metavar": "TEXT"
        },
        "verify": {
          "type": "string",
          "description": "verify command",
          "x-metavar": "CMD"
        },
        "proves": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AC[1-9][0-9]*$"
          },
          "description": "criteria it proves, comma separated",
          "x-metavar": "AC1,AC2",
          "x-split": ","
        },
        "assignee": {
          "type": "string",
          "description": "person id",
          "x-metavar": "PERSON"
        },
        "ref": {
          "type": "string",
          "description": "ticket REF (flag)",
          "pattern": "^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+(?:/T[1-9][0-9]*)?|T[1-9][0-9]*)$",
          "x-metavar": "REF"
        }
      },
      "x-positional": [
        "text"
      ],
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "output": {
      "text": "ok {key} ticket.updated {task} seq={seq}\nnext: {next}",
      "json": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      }
    },
    "errors": [
