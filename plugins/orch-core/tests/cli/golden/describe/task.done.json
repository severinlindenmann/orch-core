{
  "v": "orch.cli/2.0",
  "ok": true,
  "data": {
    "target": "task.done",
    "name": "task.done",
    "cli": "orch task done",
    "summary": "Finish a task: --run runs its verify command and stores the receipt; prints the next task.",
    "who": "agent",
    "usage": "orch task done TASK [--run] [--artifact PATH] [--ac AC] [--message TEXT] [--dry-run]",
    "pre": [
      "ticket_exists",
      "session_holds_claim",
      "task_exists",
      "session_holds_lease",
      "grant_valid",
      "text_clean"
    ],
    "emits": [
      "task.done",
      "artifact.added"
    ],
    "input": {
      "type": "object",
      "description": "Finish a task: --run runs its verify command and stores the receipt; prints the next task.",
      "properties": {
        "task": {
          "type": "string",
          "description": "task id (T3 or DEMO-0043/T3)",
          "pattern": "^(?:(?:[A-Z][A-Z0-9]{0,15}-)?[0-9]+/)?T[1-9][0-9]*$",
          "x-metavar": "TASK"
        },
        "run": {
          "type": "boolean",
          "description": "run the task's verify command first"
        },
        "artifact": {
          "type": "string",
          "description": "evidence file to store",
          "x-metavar": "PATH"
        },
        "ac": {
          "type": "string",
          "description": "criterion the evidence is for",
          "pattern": "^AC[1-9][0-9]*$",
          "x-metavar": "AC"
        },
        "message": {
          "type": "string",
          "description": "free text",
          "x-short": "m",
          "x-metavar": "TEXT"
        }
      },
      "x-positional": [
        "task"
      ],
      "required": [
        "task"
      ],
      "additionalProperties": false
    },
    "output": {
      "text": "ok {key} task.done {task}[ receipt={receipt}][ artifact={artifact}] seq={seq}\nnext: {next}",
      "json": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "receipt": {
            "type": "string"
          },
          "artifact": {
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      }
    },
    "errors": [
      {
        "code": "not_found",
        "exit": 2,
        "retryable": false,
        "hint": "orch list",
        "fix": [
          "orch",
          "list"
        ]
      },
      {
        "code": "grant.expired",
        "exit": 3,
        "retryable": false,
        "hint": "ask the person for a new grant",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "grant.required",
        "exit": 3,
        "retryable": false,
        "hint": "ask the person to run orch grant, then set ORCH_GRANT",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "transition.refused",
        "exit": 3,
        "retryable": false,
        "hint": "orch show --section current_state",
        "fix": [
          "orch",
          "show"
        ]
      },
      {
        "code": "claim.required",
        "exit": 4,
        "retryable": false,
        "hint": "orch claim",
        "fix": [
          "orch",
          "claim"
        ]
      },
      {
        "code": "lease.required",
        "exit": 4,
        "retryable": false,
        "hint": "orch task start TASK",
        "fix": [
          "orch",
          "describe",
          "task.start"
        ]
      },
      {
        "code": "lock.busy",
        "exit": 4,
        "retryable": true,
        "hint": "retry in a moment",
        "fix": [
          "orch",
          "status"
        ]
      },
      {
        "code": "verify.failed",
        "exit": 5,
        "retryable": false,
        "hint": "fix the cause, then run the task again",
        "fix": [
          "orch",
          "task",
          "next"
        ]
      }
    ]
  },
  "key": null,
  "seq": 0,
  "cursor": 0,
  "hints": []
}
